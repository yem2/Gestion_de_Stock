+/* ===== Typographie et responsive (petits écrans) ===== */
+:root{--muted:#586071}
+body{-webkit-font-smoothing:antialiased;text-rendering:optimizeLegibility}
+.page-head h1{line-height:1.2}
+.page-head p{font-size:.95rem;line-height:1.5}
+.card h3{font-size:1.05rem;line-height:1.3;margin-bottom:14px}
+.field>span{font-size:.9rem;line-height:1.3;color:#2b2f38}
+.hint{font-size:.85rem;line-height:1.45}
+input::placeholder,textarea::placeholder{color:#8a91a0}
+.btn{line-height:1.25;text-align:center;max-width:100%}
+
+/* Téléphones : un bouton ne doit jamais dépasser de sa carte, son texte passe à la ligne si besoin. */
+@media (max-width:479px){
+  .btn{white-space:normal;padding-top:10px;padding-bottom:10px}
+  .form-actions .btn{flex:1 1 100%}
+  .table .actions .btn{white-space:nowrap}
+}
+
+/* Très petits écrans (moins de 360 px) */
+@media (max-width:359px){
+  .content{padding:12px;padding-bottom:calc(24px + env(safe-area-inset-bottom))}
+  .topbar{padding-left:8px;padding-right:12px;gap:6px}
+  .page-head{margin-bottom:14px}
+  .card,.kpi{padding:14px}
+  input,select,textarea{padding:10px}
+  .modal-body{padding:14px;padding-bottom:calc(14px + env(safe-area-inset-bottom))}
+  .modal-head{padding:12px 12px 10px}
+  .search input{padding-left:38px}
+  .sale-line{grid-template-columns:minmax(0,1fr) 40px}
+  .sale-line>:first-child{grid-column:1/-1}
+  .purchase-line{grid-template-columns:minmax(0,1fr) minmax(0,1fr) 40px}
+  .purchase-line>:first-child{grid-column:1/-1}
+  .table td::before{flex-basis:34%}
+  .bars{overflow-x:auto;overflow-y:hidden}
+  .bar{min-width:30px}
+}
+
+/* Modales de produit et de mouvement (product-modal.tsx, movement-modal.tsx) : mêmes règles que les autres fenêtres. */
+.modal-heading{display:flex;align-items:flex-start;justify-content:space-between;gap:10px;padding:14px 16px 10px;border-bottom:1px solid var(--line)}
+.modal-heading h2{font-size:1.1rem;font-weight:700;line-height:1.3}
+.modal-heading p{margin-top:4px;color:var(--muted);font-size:.88rem;line-height:1.45}
+.eyebrow{margin-bottom:2px;color:var(--accent);font-size:.72rem;font-weight:800;letter-spacing:.08em}
+.icon-button{flex:none;display:grid;place-items:center;width:40px;height:40px;border:0;border-radius:10px;background:transparent;cursor:pointer}
+.icon-button:hover{background:rgba(127,127,140,.15)}
+.modal>form{display:flex;flex-direction:column;gap:14px;padding:16px;padding-bottom:calc(16px + env(safe-area-inset-bottom));overflow-y:auto}
+.modal>form label{display:flex;flex-direction:column;gap:6px;min-width:0;font-size:.9rem;font-weight:600;color:#2b2f38}
+.full-width{grid-column:1/-1}
+.form-error{padding:10px 12px;border-radius:10px;background:var(--danger-soft);color:#8f1717;font-size:.9rem}
+.modal-actions{display:flex;flex-wrap:wrap;justify-content:flex-end;gap:10px}
+.primary-button,.secondary-button{display:inline-flex;align-items:center;justify-content:center;gap:8px;min-height:44px;padding:10px 18px;border-radius:11px;font-weight:600;font-size:.95rem;line-height:1.25;text-align:center;cursor:pointer}
+.primary-button{border:1px solid var(--accent);background:var(--accent);color:#fff}
+.primary-button:hover{background:var(--accent-dark)}
+.primary-button:disabled{opacity:.55;cursor:not-allowed}
+.secondary-button{border:1px solid var(--line);background:#fff;color:var(--ink)}
+.segmented{display:flex;flex-wrap:wrap;gap:8px}
+.segmented .seg{flex:1 1 120px;min-height:42px;padding:8px 12px;border:1px solid var(--line);border-radius:10px;background:#fff;font-weight:600;font-size:.88rem;cursor:pointer}
+.segmented .seg.active{background:var(--black);border-color:var(--black);color:#fff}
+.stock-preview{padding:12px 14px;border-radius:10px;background:var(--bg);font-size:.92rem;line-height:1.5}
+.stock-preview .neg{color:var(--danger)}
+@media (max-width:479px){.modal-actions .primary-button,.modal-actions .secondary-button{flex:1 1 100%}}
+@media (max-width:359px){.modal-heading{padding:12px 12px 10px}.modal>form{padding:14px;padding-bottom:calc(14px + env(safe-area-inset-bottom))}}
+
+/* Lignes de liste : le texte long se coupe, les badges et boutons gardent leur taille. */
+.list-row>span:first-child{flex:1 1 0%;min-width:0;overflow-wrap:anywhere}
+.list-row .badge,.list-row .btn{flex:none}
+@media (max-width:479px){.list-row:has(.btn){flex-wrap:wrap}.list-row:has(.btn)>span:first-child{flex-basis:100%}}
+
+.auth-card h1{font-weight:800}
+.receipt h3{font-size:1.1rem;font-weight:800}
