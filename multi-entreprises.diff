diff -ruN -x node_modules -x tsconfig.tsbuildinfo orig/Gestion_de_Stock-main/components/warehouses-view.tsx Gestion_de_Stock-main/components/warehouses-view.tsx
--- orig/Gestion_de_Stock-main/components/warehouses-view.tsx	1970-01-01 00:00:00.000000000 +0000
+++ Gestion_de_Stock-main/components/warehouses-view.tsx	2026-10-22 11:32:39.459898473 +0000
@@ -0,0 +1,137 @@
+"use client";
+
+import { useEffect, useState } from "react";
+import { Plus } from "lucide-react";
+import { api, useApi } from "@/lib/client";
+import { can, type Role } from "@/lib/roles";
+import { Alert, Empty, Field, Loading, Modal, PageHeader } from "@/components/ui";
+
+type Warehouse = { id: string; name: string; code: string; status: "active" | "inactive"; isDefault: boolean; products: number; units: number };
+type StockLine = { id: number; sku: string; name: string; onHand: number; available: number };
+
+function StockModal({ warehouse, onClose }: { warehouse: Warehouse; onClose: () => void }) {
+  const [lines, setLines] = useState<StockLine[] | null>(null);
+  const [error, setError] = useState("");
+
+  useEffect(() => {
+    api<{ stock: StockLine[] }>(`/api/warehouses/${warehouse.id}/stock`)
+      .then((data) => setLines(data.stock))
+      .catch((e) => setError(e instanceof Error ? e.message : "Chargement impossible."));
+  }, [warehouse.id]);
+
+  return (
+    <Modal title={`Stock : ${warehouse.name}`} onClose={onClose}>
+      {error && <Alert>{error}</Alert>}
+      {!lines && !error ? <Loading /> : lines && lines.length === 0 ? (
+        <Empty>Aucun produit en stock dans cet entrepôt.</Empty>
+      ) : (
+        <div className="table-card"><div className="table-wrap">
+          <table className="table">
+            <thead><tr><th>Produit</th><th>Référence</th><th className="num">En stock</th><th className="num">Disponible</th></tr></thead>
+            <tbody>
+              {lines?.map((l) => (
+                <tr key={l.id}>
+                  <td data-label="Produit"><strong>{l.name}</strong></td>
+                  <td data-label="Référence">{l.sku}</td>
+                  <td data-label="En stock" className="num">{l.onHand}</td>
+                  <td data-label="Disponible" className="num">{l.available}</td>
+                </tr>
+              ))}
+            </tbody>
+          </table>
+        </div></div>
+      )}
+    </Modal>
+  );
+}
+
+export default function WarehousesView({ role }: { role: Role }) {
+  const { data, error, loading, reload } = useApi<{ warehouses: Warehouse[] }>("/api/warehouses");
+  const [editing, setEditing] = useState<Warehouse | "new" | null>(null);
+  const [viewing, setViewing] = useState<Warehouse | null>(null);
+  const [formError, setFormError] = useState("");
+  const [saving, setSaving] = useState(false);
+  const [notice, setNotice] = useState("");
+  const canWrite = can(role, "warehouses.write");
+  const list = data?.warehouses ?? [];
+  const current = editing && editing !== "new" ? editing : null;
+
+  async function save(event: React.FormEvent<HTMLFormElement>) {
+    event.preventDefault();
+    setFormError("");
+    setSaving(true);
+    const form = Object.fromEntries(new FormData(event.currentTarget).entries());
+    try {
+      if (current) await api(`/api/warehouses/${current.id}`, { method: "PATCH", body: JSON.stringify(form) });
+      else await api("/api/warehouses", { method: "POST", body: JSON.stringify(form) });
+      setEditing(null);
+      setNotice(current ? "Modifications enregistrées." : "Entrepôt créé.");
+      await reload();
+    } catch (e) {
+      setFormError(e instanceof Error ? e.message : "Enregistrement impossible.");
+    } finally {
+      setSaving(false);
+    }
+  }
+
+  return (
+    <>
+      <PageHeader title="Entrepôts" subtitle="Vos lieux de stockage et le stock qu’ils détiennent.">
+        {canWrite && <button type="button" className="btn btn-primary" onClick={() => { setFormError(""); setEditing("new"); }}><Plus size={18} /> Ajouter un entrepôt</button>}
+      </PageHeader>
+      {notice && <Alert kind="success">{notice}</Alert>}
+      {error && <Alert>{error}</Alert>}
+
+      {loading && !data ? <Loading /> : list.length === 0 ? (
+        <Empty>Aucun entrepôt.</Empty>
+      ) : (
+        <div className="table-card"><div className="table-wrap">
+          <table className="table">
+            <thead><tr><th>Nom</th><th>Code</th><th>Statut</th><th className="num">Produits</th><th className="num">Unités</th><th /></tr></thead>
+            <tbody>
+              {list.map((w) => (
+                <tr key={w.id}>
+                  <td data-label="Nom"><strong>{w.name}</strong>{w.isDefault && <> <span className="badge badge-muted">Principal</span></>}</td>
+                  <td data-label="Code">{w.code}</td>
+                  <td data-label="Statut"><span className={`badge ${w.status === "active" ? "badge-ok" : "badge-muted"}`}>{w.status === "active" ? "Actif" : "Inactif"}</span></td>
+                  <td data-label="Produits" className="num">{w.products}</td>
+                  <td data-label="Unités" className="num">{w.units}</td>
+                  <td className="actions">
+                    <button type="button" className="btn btn-sm" onClick={() => setViewing(w)}>Voir le stock</button>
+                    {canWrite && <button type="button" className="btn btn-sm" onClick={() => { setFormError(""); setEditing(w); }}>Modifier</button>}
+                  </td>
+                </tr>
+              ))}
+            </tbody>
+          </table>
+        </div></div>
+      )}
+
+      {viewing && <StockModal warehouse={viewing} onClose={() => setViewing(null)} />}
+
+      {editing && (
+        <Modal title={current ? `Modifier : ${current.name}` : "Nouvel entrepôt"} onClose={() => setEditing(null)}>
+          <form onSubmit={save}>
+            {formError && <Alert>{formError}</Alert>}
+            <div className="form-grid">
+              <Field label="Nom" span><input name="name" required minLength={2} defaultValue={current?.name} /></Field>
+              <Field label="Code"><input name="code" required minLength={2} maxLength={20} defaultValue={current?.code} placeholder="DLA" /></Field>
+              {current && (
+                <Field label="Statut">
+                  <select name="status" defaultValue={current.status}>
+                    <option value="active">Actif</option>
+                    <option value="inactive">Inactif</option>
+                  </select>
+                </Field>
+              )}
+            </div>
+            <div className="form-actions">
+              <button type="button" className="btn" onClick={() => setEditing(null)}>Annuler</button>
+              <button type="submit" className="btn btn-primary" disabled={saving}>{saving ? "Enregistrement…" : "Enregistrer"}</button>
+            </div>
+          </form>
+        </Modal>
+      )}
+    </>
+  );
+}
diff -ruN -x node_modules -x tsconfig.tsbuildinfo orig/Gestion_de_Stock-main/db/0005_multi_company_rbac.sql Gestion_de_Stock-main/db/0005_multi_company_rbac.sql
--- orig/Gestion_de_Stock-main/db/0005_multi_company_rbac.sql	1970-01-01 00:00:00.000000000 +0000
+++ Gestion_de_Stock-main/db/0005_multi_company_rbac.sql	2026-10-21 07:59:29.388907131 +0000
@@ -0,0 +1,163 @@
+-- Gestion de Stock: multi-entreprises + RBAC (phase 02 du cahier des charges).
+-- À exécuter UNE SEULE FOIS dans la base Neon, après 0000 → 0004. Testé sur une branche Neon avant production.
+-- Les données existantes sont rattachées à l'entreprise « Entreprise par défaut » (UUID fixe ...0001).
+CREATE TABLE companies (
+  id uuid PRIMARY KEY DEFAULT gen_random_uuid(),
+  name text NOT NULL,
+  slug text NOT NULL UNIQUE,
+  currency char(3) NOT NULL DEFAULT 'XAF',
+  status text NOT NULL DEFAULT 'active' CHECK (status IN ('active','suspended','archived')),
+  settings jsonb NOT NULL DEFAULT '{}'::jsonb,
+  created_at timestamptz NOT NULL DEFAULT now(),
+  updated_at timestamptz NOT NULL DEFAULT now()
+);
+INSERT INTO companies (id, name, slug) VALUES ('00000000-0000-0000-0000-000000000001', 'Entreprise par défaut', 'default');
+
+CREATE TABLE permissions (
+  id uuid PRIMARY KEY DEFAULT gen_random_uuid(),
+  code text NOT NULL UNIQUE,
+  description text
+);
+
+CREATE TABLE roles (
+  id uuid PRIMARY KEY DEFAULT gen_random_uuid(),
+  company_id uuid NOT NULL REFERENCES companies(id) ON DELETE CASCADE,
+  name text NOT NULL,
+  is_system boolean NOT NULL DEFAULT false,
+  created_at timestamptz NOT NULL DEFAULT now(),
+  UNIQUE (company_id, name),
+  UNIQUE (id, company_id)
+);
+
+CREATE TABLE role_permissions (
+  role_id uuid NOT NULL REFERENCES roles(id) ON DELETE CASCADE,
+  permission_id uuid NOT NULL REFERENCES permissions(id) ON DELETE CASCADE,
+  PRIMARY KEY (role_id, permission_id)
+);
+
+CREATE TABLE company_memberships (
+  id uuid PRIMARY KEY DEFAULT gen_random_uuid(),
+  company_id uuid NOT NULL REFERENCES companies(id) ON DELETE CASCADE,
+  user_id bigint NOT NULL REFERENCES users(id) ON DELETE CASCADE,
+  status text NOT NULL DEFAULT 'active' CHECK (status IN ('invited','active','suspended')),
+  created_at timestamptz NOT NULL DEFAULT now(),
+  UNIQUE (company_id, user_id),
+  UNIQUE (id, company_id)
+);
+
+CREATE TABLE membership_roles (
+  company_id uuid NOT NULL,
+  membership_id uuid NOT NULL,
+  role_id uuid NOT NULL,
+  PRIMARY KEY (membership_id, role_id),
+  FOREIGN KEY (membership_id, company_id) REFERENCES company_memberships(id, company_id) ON DELETE CASCADE,
+  FOREIGN KEY (role_id, company_id) REFERENCES roles(id, company_id) ON DELETE CASCADE
+);
+
+INSERT INTO permissions (code) VALUES
+('companies.manage'),('users.manage'),('roles.manage'),('audit.read'),
+('products.read'),('products.create'),('products.update'),('products.archive'),
+('warehouses.read'),('warehouses.manage'),
+('inventory.read'),('inventory.adjust'),('inventory.transfer.create'),('inventory.transfer.ship'),
+('inventory.transfer.receive'),('inventory.count'),('inventory.count.approve'),
+('suppliers.read'),('suppliers.manage'),
+('purchases.read'),('purchases.create'),('purchases.submit'),('purchases.approve'),('purchases.receive'),('purchases.cancel'),
+('customers.read'),('customers.manage'),
+('sales.read'),('sales.create'),('sales.validate'),('sales.discount.override'),('sales.return'),('sales.refund'),
+('payments.read'),('payments.record'),('payments.reverse'),
+('expenses.read'),('expenses.create'),('expenses.approve'),
+('reports.stock.read'),('reports.finance.read');
+
+INSERT INTO roles (company_id, name, is_system) VALUES
+('00000000-0000-0000-0000-000000000001','Administrateur entreprise',true),
+('00000000-0000-0000-0000-000000000001','Directeur',true),
+('00000000-0000-0000-0000-000000000001','Gestionnaire de stock',true),
+('00000000-0000-0000-0000-000000000001','Responsable achats',true),
+('00000000-0000-0000-0000-000000000001','Vendeur / Caissier',true),
+('00000000-0000-0000-0000-000000000001','Comptable',true),
+('00000000-0000-0000-0000-000000000001','Auditeur',true);
+
+INSERT INTO role_permissions (role_id, permission_id)
+SELECT r.id, p.id
+FROM roles r
+JOIN (VALUES
+  ('Administrateur entreprise', '.*'),
+  ('Directeur', '\.read$|\.approve$|^sales\.validate$|^payments\.reverse$'),
+  ('Gestionnaire de stock', '^(products\.(read|create|update|archive)|warehouses\.read|inventory\..*|reports\.stock\.read|suppliers\.read)$'),
+  ('Responsable achats', '^(suppliers\..*|purchases\..*|products\.read|inventory\.read|warehouses\.read|reports\.stock\.read)$'),
+  ('Vendeur / Caissier', '^(products\.read|inventory\.read|customers\..*|sales\.(read|create|validate|return)|payments\.(read|record))$'),
+  ('Comptable', '^(payments\..*|expenses\..*|sales\.(read|refund)|purchases\.read|customers\.read|suppliers\.read|reports\..*)$'),
+  ('Auditeur', '\.read$')
+) AS t(name, pattern) ON t.name = r.name
+JOIN permissions p ON p.code ~ t.pattern;
+
+INSERT INTO company_memberships (company_id, user_id, status)
+SELECT '00000000-0000-0000-0000-000000000001', u.id, CASE WHEN u.active THEN 'active' ELSE 'suspended' END FROM users u;
+
+INSERT INTO membership_roles (company_id, membership_id, role_id)
+SELECT m.company_id, m.id, r.id
+FROM company_memberships m
+JOIN users u ON u.id = m.user_id
+JOIN roles r ON r.company_id = m.company_id AND r.name = CASE u.role
+  WHEN 'super_admin' THEN 'Administrateur entreprise'
+  WHEN 'admin' THEN 'Administrateur entreprise'
+  WHEN 'manager' THEN 'Directeur'
+  WHEN 'storekeeper' THEN 'Gestionnaire de stock'
+  WHEN 'seller' THEN 'Vendeur / Caissier' END;
+
+-- company_id sur les tables métier. Le DEFAULT est TRANSITOIRE : il est retiré par 0008 une fois le nouveau code déployé.
+ALTER TABLE products ADD COLUMN company_id uuid REFERENCES companies(id);
+UPDATE products SET company_id = '00000000-0000-0000-0000-000000000001';
+ALTER TABLE products ALTER COLUMN company_id SET NOT NULL;
+ALTER TABLE products ALTER COLUMN company_id SET DEFAULT '00000000-0000-0000-0000-000000000001';
+CREATE INDEX products_company_idx ON products (company_id);
+ALTER TABLE products ADD CONSTRAINT products_id_company_key UNIQUE (id, company_id);
+
+ALTER TABLE suppliers ADD COLUMN company_id uuid REFERENCES companies(id);
+UPDATE suppliers SET company_id = '00000000-0000-0000-0000-000000000001';
+ALTER TABLE suppliers ALTER COLUMN company_id SET NOT NULL;
+ALTER TABLE suppliers ALTER COLUMN company_id SET DEFAULT '00000000-0000-0000-0000-000000000001';
+CREATE INDEX suppliers_company_idx ON suppliers (company_id);
+ALTER TABLE suppliers ADD CONSTRAINT suppliers_id_company_key UNIQUE (id, company_id);
+
+ALTER TABLE customers ADD COLUMN company_id uuid REFERENCES companies(id);
+UPDATE customers SET company_id = '00000000-0000-0000-0000-000000000001';
+ALTER TABLE customers ALTER COLUMN company_id SET NOT NULL;
+ALTER TABLE customers ALTER COLUMN company_id SET DEFAULT '00000000-0000-0000-0000-000000000001';
+CREATE INDEX customers_company_idx ON customers (company_id);
+ALTER TABLE customers ADD CONSTRAINT customers_id_company_key UNIQUE (id, company_id);
+
+ALTER TABLE purchase_orders ADD COLUMN company_id uuid REFERENCES companies(id);
+UPDATE purchase_orders SET company_id = '00000000-0000-0000-0000-000000000001';
+ALTER TABLE purchase_orders ALTER COLUMN company_id SET NOT NULL;
+ALTER TABLE purchase_orders ALTER COLUMN company_id SET DEFAULT '00000000-0000-0000-0000-000000000001';
+CREATE INDEX purchase_orders_company_idx ON purchase_orders (company_id);
+ALTER TABLE purchase_orders ADD CONSTRAINT purchase_orders_id_company_key UNIQUE (id, company_id);
+
+ALTER TABLE sales ADD COLUMN company_id uuid REFERENCES companies(id);
+UPDATE sales SET company_id = '00000000-0000-0000-0000-000000000001';
+ALTER TABLE sales ALTER COLUMN company_id SET NOT NULL;
+ALTER TABLE sales ALTER COLUMN company_id SET DEFAULT '00000000-0000-0000-0000-000000000001';
+CREATE INDEX sales_company_idx ON sales (company_id);
+ALTER TABLE sales ADD CONSTRAINT sales_id_company_key UNIQUE (id, company_id);
+
+ALTER TABLE stock_movements ADD COLUMN company_id uuid REFERENCES companies(id);
+UPDATE stock_movements SET company_id = '00000000-0000-0000-0000-000000000001';
+ALTER TABLE stock_movements ALTER COLUMN company_id SET NOT NULL;
+ALTER TABLE stock_movements ALTER COLUMN company_id SET DEFAULT '00000000-0000-0000-0000-000000000001';
+CREATE INDEX stock_movements_company_idx ON stock_movements (company_id);
+ALTER TABLE stock_movements ADD CONSTRAINT stock_movements_id_company_key UNIQUE (id, company_id);
+
+ALTER TABLE audit_log ADD COLUMN company_id uuid REFERENCES companies(id);
+UPDATE audit_log SET company_id = '00000000-0000-0000-0000-000000000001';
+CREATE INDEX audit_log_company_idx ON audit_log (company_id, created_at DESC);
+
+-- SKU unique par entreprise (et non plus global).
+ALTER TABLE products DROP CONSTRAINT products_sku_key;
+ALTER TABLE products ADD CONSTRAINT products_company_sku_key UNIQUE (company_id, sku);
+
+-- Clés étrangères composites : impossible de relier des données de deux entreprises différentes.
+ALTER TABLE stock_movements ADD CONSTRAINT stock_movements_product_company_fk FOREIGN KEY (product_id, company_id) REFERENCES products(id, company_id);
+ALTER TABLE stock_movements ADD CONSTRAINT stock_movements_supplier_company_fk FOREIGN KEY (supplier_id, company_id) REFERENCES suppliers(id, company_id);
+ALTER TABLE sales ADD CONSTRAINT sales_customer_company_fk FOREIGN KEY (customer_id, company_id) REFERENCES customers(id, company_id);
+ALTER TABLE purchase_orders ADD CONSTRAINT purchase_orders_supplier_company_fk FOREIGN KEY (supplier_id, company_id) REFERENCES suppliers(id, company_id);
diff -ruN -x node_modules -x tsconfig.tsbuildinfo orig/Gestion_de_Stock-main/db/0006_warehouses_balances.sql Gestion_de_Stock-main/db/0006_warehouses_balances.sql
--- orig/Gestion_de_Stock-main/db/0006_warehouses_balances.sql	1970-01-01 00:00:00.000000000 +0000
+++ Gestion_de_Stock-main/db/0006_warehouses_balances.sql	2026-10-21 07:59:29.389738063 +0000
@@ -0,0 +1,64 @@
+-- Gestion de Stock: entrepôts, unités, catégories et soldes par entrepôt (phase 03, première partie).
+-- À exécuter après 0005. products.quantity est conservée (stock de l'entrepôt par défaut) ; voir 0007 pour la synchronisation.
+CREATE TABLE warehouses (
+  id uuid PRIMARY KEY DEFAULT gen_random_uuid(),
+  company_id uuid NOT NULL REFERENCES companies(id) ON DELETE CASCADE,
+  name text NOT NULL,
+  code text NOT NULL,
+  status text NOT NULL DEFAULT 'active' CHECK (status IN ('active','inactive')),
+  is_default boolean NOT NULL DEFAULT false,
+  created_at timestamptz NOT NULL DEFAULT now(),
+  UNIQUE (company_id, code),
+  UNIQUE (id, company_id)
+);
+CREATE UNIQUE INDEX warehouses_one_default_idx ON warehouses (company_id) WHERE is_default;
+
+CREATE TABLE units (
+  id uuid PRIMARY KEY DEFAULT gen_random_uuid(),
+  company_id uuid NOT NULL REFERENCES companies(id) ON DELETE CASCADE,
+  name text NOT NULL,
+  symbol text NOT NULL,
+  precision smallint NOT NULL DEFAULT 0 CHECK (precision BETWEEN 0 AND 4),
+  UNIQUE (company_id, symbol),
+  UNIQUE (id, company_id)
+);
+
+CREATE TABLE categories (
+  id uuid PRIMARY KEY DEFAULT gen_random_uuid(),
+  company_id uuid NOT NULL REFERENCES companies(id) ON DELETE CASCADE,
+  parent_id uuid,
+  name text NOT NULL,
+  UNIQUE (company_id, name),
+  UNIQUE (id, company_id),
+  FOREIGN KEY (parent_id, company_id) REFERENCES categories(id, company_id)
+);
+
+ALTER TABLE products ADD COLUMN category_id uuid, ADD COLUMN base_unit_id uuid;
+ALTER TABLE products ADD CONSTRAINT products_category_company_fk FOREIGN KEY (category_id, company_id) REFERENCES categories(id, company_id);
+ALTER TABLE products ADD CONSTRAINT products_unit_company_fk FOREIGN KEY (base_unit_id, company_id) REFERENCES units(id, company_id);
+
+CREATE TABLE stock_balances (
+  id uuid PRIMARY KEY DEFAULT gen_random_uuid(),
+  company_id uuid NOT NULL REFERENCES companies(id) ON DELETE CASCADE,
+  warehouse_id uuid NOT NULL,
+  product_id bigint NOT NULL,
+  quantity_on_hand numeric(19,4) NOT NULL DEFAULT 0 CHECK (quantity_on_hand >= 0),
+  quantity_reserved numeric(19,4) NOT NULL DEFAULT 0 CHECK (quantity_reserved >= 0),
+  updated_at timestamptz NOT NULL DEFAULT now(),
+  UNIQUE (company_id, warehouse_id, product_id),
+  CHECK (quantity_reserved <= quantity_on_hand),
+  FOREIGN KEY (warehouse_id, company_id) REFERENCES warehouses(id, company_id),
+  FOREIGN KEY (product_id, company_id) REFERENCES products(id, company_id)
+);
+CREATE INDEX stock_balances_product_idx ON stock_balances (company_id, product_id);
+
+ALTER TABLE stock_movements ADD COLUMN warehouse_id uuid, ADD COLUMN unit_cost numeric(19,4), ADD COLUMN source_type text, ADD COLUMN source_id text;
+ALTER TABLE stock_movements ADD CONSTRAINT stock_movements_warehouse_company_fk FOREIGN KEY (warehouse_id, company_id) REFERENCES warehouses(id, company_id);
+
+INSERT INTO warehouses (company_id, name, code, is_default) SELECT id, 'Entrepôt principal', 'MAIN', true FROM companies;
+INSERT INTO units (company_id, name, symbol, precision) SELECT id, 'Pièce', 'pc', 0 FROM companies;
+INSERT INTO categories (company_id, name) SELECT DISTINCT company_id, btrim(category) FROM products WHERE category IS NOT NULL AND btrim(category) <> '';
+UPDATE products p SET category_id = c.id FROM categories c WHERE c.company_id = p.company_id AND c.name = btrim(p.category);
+UPDATE products p SET base_unit_id = u.id FROM units u WHERE u.company_id = p.company_id AND u.symbol = 'pc';
+INSERT INTO stock_balances (company_id, warehouse_id, product_id, quantity_on_hand) SELECT p.company_id, w.id, p.id, p.quantity FROM products p JOIN warehouses w ON w.company_id = p.company_id AND w.is_default;
+UPDATE stock_movements m SET warehouse_id = w.id FROM warehouses w WHERE w.company_id = m.company_id AND w.is_default;
diff -ruN -x node_modules -x tsconfig.tsbuildinfo orig/Gestion_de_Stock-main/db/0007_sync_triggers.sql Gestion_de_Stock-main/db/0007_sync_triggers.sql
--- orig/Gestion_de_Stock-main/db/0007_sync_triggers.sql	1970-01-01 00:00:00.000000000 +0000
+++ Gestion_de_Stock-main/db/0007_sync_triggers.sql	2026-10-21 07:59:29.390522733 +0000
@@ -0,0 +1,31 @@
+-- Gestion de Stock: synchronisation transitoire de stock_balances et index d'appartenance.
+-- À exécuter après 0006 (une instruction à la fois dans le SQL Editor si nécessaire).
+-- Tant que products.quantity reste la quantité de l'entrepôt par défaut, chaque modification met à jour son solde.
+CREATE OR REPLACE FUNCTION sync_stock_balance() RETURNS trigger LANGUAGE plpgsql AS $$
+BEGIN
+  INSERT INTO stock_balances (company_id, warehouse_id, product_id, quantity_on_hand)
+  SELECT NEW.company_id, w.id, NEW.id, NEW.quantity
+  FROM warehouses w WHERE w.company_id = NEW.company_id AND w.is_default
+  ON CONFLICT (company_id, warehouse_id, product_id)
+  DO UPDATE SET quantity_on_hand = EXCLUDED.quantity_on_hand, updated_at = now();
+  RETURN NULL;
+END
+$$;
+
+CREATE TRIGGER products_sync_balance AFTER INSERT OR UPDATE OF quantity ON products
+  FOR EACH ROW EXECUTE FUNCTION sync_stock_balance();
+
+-- Un mouvement sans entrepôt explicite est rattaché à l'entrepôt par défaut de son entreprise.
+CREATE OR REPLACE FUNCTION set_movement_warehouse() RETURNS trigger LANGUAGE plpgsql AS $$
+BEGIN
+  IF NEW.warehouse_id IS NULL THEN
+    SELECT id INTO NEW.warehouse_id FROM warehouses WHERE company_id = NEW.company_id AND is_default;
+  END IF;
+  RETURN NEW;
+END
+$$;
+
+CREATE TRIGGER stock_movements_default_wh BEFORE INSERT ON stock_movements
+  FOR EACH ROW EXECUTE FUNCTION set_movement_warehouse();
+
+CREATE INDEX IF NOT EXISTS company_memberships_user_idx ON company_memberships (user_id);
