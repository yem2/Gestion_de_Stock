+      )}
+
+      {target && (
+        <PayModal
+          target={target}
+          methods={methods.data?.methods ?? []}
+          onClose={() => setTarget(null)}
+          onDone={(message) => { setTarget(null); setNotice(message); void reloadAll(); }}
+        />
+      )}
+    </>
+  );
+}
