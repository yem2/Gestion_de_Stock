+-- 0010 : Phase 03 du cahier des charges (catalogue et stock) + tables transversales.
+-- Migration ADDITIVE uniquement : aucune table ni colonne existante n'est modifiée ou supprimée,
+-- donc sans risque pour le code déjà en production. Idempotente (peut être rejouée).
+
+-- ---------- Catalogue ----------
+CREATE TABLE IF NOT EXISTS brands (
+  id uuid PRIMARY KEY DEFAULT gen_random_uuid(),
+  company_id uuid NOT NULL REFERENCES companies(id),
+  name text NOT NULL CHECK (length(btrim(name)) > 0),
+  UNIQUE (company_id, name),
+  UNIQUE (id, company_id)
+);
+
+CREATE TABLE IF NOT EXISTS locations (
+  id uuid PRIMARY KEY DEFAULT gen_random_uuid(),
+  company_id uuid NOT NULL REFERENCES companies(id),
+  warehouse_id uuid NOT NULL,
+  parent_id uuid,
+  code text NOT NULL CHECK (length(btrim(code)) > 0),
+  name text,
+  status text NOT NULL DEFAULT 'active' CHECK (status IN ('active','inactive')),
+  UNIQUE (id, company_id),
+  UNIQUE (company_id, warehouse_id, code),
+  FOREIGN KEY (warehouse_id, company_id) REFERENCES warehouses(id, company_id),
+  FOREIGN KEY (parent_id, company_id) REFERENCES locations(id, company_id)
+);
+
+CREATE TABLE IF NOT EXISTS product_barcodes (
+  id uuid PRIMARY KEY DEFAULT gen_random_uuid(),
+  company_id uuid NOT NULL REFERENCES companies(id),
+  product_id bigint NOT NULL,
+  barcode text NOT NULL CHECK (length(btrim(barcode)) > 0),
+  unit_id uuid,
+  created_at timestamptz NOT NULL DEFAULT now(),
+  UNIQUE (company_id, barcode),
+  FOREIGN KEY (product_id, company_id) REFERENCES products(id, company_id),
+  FOREIGN KEY (unit_id, company_id) REFERENCES units(id, company_id)
+);
+CREATE INDEX IF NOT EXISTS product_barcodes_product_idx ON product_barcodes (company_id, product_id);
+
+CREATE TABLE IF NOT EXISTS product_prices (
+  id uuid PRIMARY KEY DEFAULT gen_random_uuid(),
+  company_id uuid NOT NULL REFERENCES companies(id),
+  product_id bigint NOT NULL,
+  price_type text NOT NULL CHECK (price_type IN ('sale','purchase')),
+  amount numeric(19,4) NOT NULL CHECK (amount >= 0),
+  valid_from timestamptz NOT NULL DEFAULT now(),
+  created_by bigint REFERENCES users(id),
+  FOREIGN KEY (product_id, company_id) REFERENCES products(id, company_id)
+);
+CREATE INDEX IF NOT EXISTS product_prices_lookup_idx ON product_prices (company_id, product_id, price_type, valid_from DESC);
+
+-- ---------- Transferts entre entrepôts ----------
+CREATE TABLE IF NOT EXISTS stock_transfers (
+  id uuid PRIMARY KEY DEFAULT gen_random_uuid(),
+  company_id uuid NOT NULL REFERENCES companies(id),
+  transfer_number text NOT NULL,
+  source_warehouse_id uuid NOT NULL,
+  destination_warehouse_id uuid NOT NULL,
+  status text NOT NULL DEFAULT 'draft' CHECK (status IN ('draft','shipped','received','cancelled')),
+  note text,
+  created_by bigint REFERENCES users(id),
+  shipped_at timestamptz,
+  received_at timestamptz,
+  created_at timestamptz NOT NULL DEFAULT now(),
+  CHECK (source_warehouse_id <> destination_warehouse_id),
+  UNIQUE (id, company_id),
+  UNIQUE (company_id, transfer_number),
+  FOREIGN KEY (source_warehouse_id, company_id) REFERENCES warehouses(id, company_id),
+  FOREIGN KEY (destination_warehouse_id, company_id) REFERENCES warehouses(id, company_id)
+);
+
+CREATE TABLE IF NOT EXISTS stock_transfer_lines (
+  id uuid PRIMARY KEY DEFAULT gen_random_uuid(),
+  company_id uuid NOT NULL REFERENCES companies(id),
+  transfer_id uuid NOT NULL,
+  product_id bigint NOT NULL,
+  quantity_requested numeric(19,4) NOT NULL CHECK (quantity_requested > 0),
+  quantity_shipped numeric(19,4) NOT NULL DEFAULT 0 CHECK (quantity_shipped >= 0),
+  quantity_received numeric(19,4) NOT NULL DEFAULT 0 CHECK (quantity_received >= 0),
+  CHECK (quantity_received <= quantity_shipped),
+  FOREIGN KEY (transfer_id, company_id) REFERENCES stock_transfers(id, company_id) ON DELETE CASCADE,
+  FOREIGN KEY (product_id, company_id) REFERENCES products(id, company_id)
+);
+CREATE INDEX IF NOT EXISTS stock_transfer_lines_transfer_idx ON stock_transfer_lines (transfer_id);
+
+-- ---------- Inventaires physiques ----------
+CREATE TABLE IF NOT EXISTS inventory_counts (
+  id uuid PRIMARY KEY DEFAULT gen_random_uuid(),
+  company_id uuid NOT NULL REFERENCES companies(id),
+  count_number text NOT NULL,
+  warehouse_id uuid NOT NULL,
+  status text NOT NULL DEFAULT 'open' CHECK (status IN ('open','submitted','approved','cancelled')),
+  created_by bigint REFERENCES users(id),
+  approved_by bigint REFERENCES users(id),
+  created_at timestamptz NOT NULL DEFAULT now(),
+  approved_at timestamptz,
+  UNIQUE (id, company_id),
+  UNIQUE (company_id, count_number),
+  FOREIGN KEY (warehouse_id, company_id) REFERENCES warehouses(id, company_id)
+);
+
+CREATE TABLE IF NOT EXISTS inventory_count_lines (
+  id uuid PRIMARY KEY DEFAULT gen_random_uuid(),
+  company_id uuid NOT NULL REFERENCES companies(id),
+  count_id uuid NOT NULL,
+  product_id bigint NOT NULL,
+  expected_quantity numeric(19,4) NOT NULL CHECK (expected_quantity >= 0),
+  counted_quantity numeric(19,4) CHECK (counted_quantity >= 0),
+  UNIQUE (count_id, product_id),
+  FOREIGN KEY (count_id, company_id) REFERENCES inventory_counts(id, company_id) ON DELETE CASCADE,
+  FOREIGN KEY (product_id, company_id) REFERENCES products(id, company_id)
+);
+
+-- ---------- Réservations ----------
+CREATE TABLE IF NOT EXISTS stock_reservations (
+  id uuid PRIMARY KEY DEFAULT gen_random_uuid(),
+  company_id uuid NOT NULL REFERENCES companies(id),
+  product_id bigint NOT NULL,
+  warehouse_id uuid NOT NULL,
+  document_type text NOT NULL,
+  document_id text NOT NULL,
+  quantity numeric(19,4) NOT NULL CHECK (quantity > 0),
+  status text NOT NULL DEFAULT 'active' CHECK (status IN ('active','released','consumed')),
+  created_at timestamptz NOT NULL DEFAULT now(),
+  FOREIGN KEY (product_id, company_id) REFERENCES products(id, company_id),
+  FOREIGN KEY (warehouse_id, company_id) REFERENCES warehouses(id, company_id)
+);
+CREATE INDEX IF NOT EXISTS stock_reservations_active_idx ON stock_reservations (company_id, product_id, warehouse_id) WHERE status = 'active';
+
+-- ---------- Transversal : numérotation, idempotence, outbox, notifications ----------
+CREATE TABLE IF NOT EXISTS document_sequences (
+  company_id uuid NOT NULL REFERENCES companies(id),
+  document_type text NOT NULL,
+  period text NOT NULL DEFAULT '',
+  next_value bigint NOT NULL DEFAULT 1 CHECK (next_value > 0),
+  PRIMARY KEY (company_id, document_type, period)
+);
+
+CREATE TABLE IF NOT EXISTS idempotency_keys (
+  company_id uuid NOT NULL REFERENCES companies(id),
+  key text NOT NULL CHECK (length(key) BETWEEN 8 AND 200),
+  operation text NOT NULL,
+  result_reference text,
+  created_at timestamptz NOT NULL DEFAULT now(),
+  PRIMARY KEY (company_id, key, operation)
+);
+
+CREATE TABLE IF NOT EXISTS outbox_events (
+  id uuid PRIMARY KEY DEFAULT gen_random_uuid(),
+  company_id uuid NOT NULL REFERENCES companies(id),
+  event_type text NOT NULL,
+  payload jsonb NOT NULL DEFAULT '{}',
+  status text NOT NULL DEFAULT 'pending' CHECK (status IN ('pending','processing','done','failed')),
+  attempts int NOT NULL DEFAULT 0,
+  next_attempt_at timestamptz NOT NULL DEFAULT now(),
+  created_at timestamptz NOT NULL DEFAULT now()
+);
+CREATE INDEX IF NOT EXISTS outbox_pending_idx ON outbox_events (next_attempt_at) WHERE status IN ('pending','failed');
+
+CREATE TABLE IF NOT EXISTS notifications (
+  id uuid PRIMARY KEY DEFAULT gen_random_uuid(),
+  company_id uuid NOT NULL REFERENCES companies(id),
+  user_id bigint REFERENCES users(id),
+  type text NOT NULL,
+  payload jsonb NOT NULL DEFAULT '{}',
+  read_at timestamptz,
+  created_at timestamptz NOT NULL DEFAULT now(),
+  UNIQUE (id, company_id)
+);
+CREATE INDEX IF NOT EXISTS notifications_user_idx ON notifications (company_id, user_id, created_at DESC);
+
+CREATE TABLE IF NOT EXISTS notification_deliveries (
+  id uuid PRIMARY KEY DEFAULT gen_random_uuid(),
+  company_id uuid NOT NULL REFERENCES companies(id),
+  notification_id uuid NOT NULL,
+  channel text NOT NULL CHECK (channel IN ('in_app','email','sms','whatsapp')),
+  status text NOT NULL DEFAULT 'pending' CHECK (status IN ('pending','sent','failed')),
+  attempts int NOT NULL DEFAULT 0,
+  last_error text,
+  FOREIGN KEY (notification_id, company_id) REFERENCES notifications(id, company_id) ON DELETE CASCADE
+);
+
+-- ---------- Catalogue complet des permissions (section 4.2) ----------
+INSERT INTO permissions (code, description) VALUES
+ ('products.read','Consulter les produits'),('products.create','Créer des produits'),('products.update','Modifier des produits'),('products.archive','Archiver des produits'),
+ ('inventory.read','Consulter les stocks'),('inventory.adjust','Ajuster le stock'),('inventory.transfer.create','Créer un transfert'),
+ ('inventory.transfer.ship','Expédier un transfert'),('inventory.transfer.receive','Réceptionner un transfert'),
+ ('inventory.count','Compter un inventaire'),('inventory.count.approve','Approuver un inventaire'),
+ ('purchases.create','Créer une commande d''achat'),('purchases.submit','Soumettre une commande'),('purchases.approve','Approuver une commande'),
+ ('purchases.receive','Réceptionner une commande'),('purchases.cancel','Annuler une commande'),
+ ('sales.create','Créer une vente'),('sales.validate','Valider une vente'),('sales.discount.override','Accorder des remises hors règle'),
+ ('sales.return','Enregistrer un retour client'),('sales.refund','Rembourser un client'),
+ ('payments.record','Enregistrer un paiement'),('payments.reverse','Contrepasser un paiement'),
+ ('expenses.create','Créer une dépense'),('expenses.approve','Approuver une dépense'),
+ ('reports.stock.read','Consulter les rapports de stock'),('reports.finance.read','Consulter les rapports financiers'),
+ ('users.manage','Gérer les utilisateurs'),('roles.manage','Gérer les rôles'),('audit.read','Consulter le journal d''audit')
+ON CONFLICT (code) DO NOTHING;
+
+-- Rôles système : l'administrateur d'entreprise reçoit tout ; les autres rôles reçoivent leur périmètre.
+INSERT INTO role_permissions (role_id, permission_id)
+SELECT r.id, p.id FROM roles r JOIN permissions p ON (
+  (r.name = 'Administrateur entreprise')
+  OR (r.name = 'Directeur' AND p.code IN ('products.read','inventory.read','purchases.approve','sales.validate','sales.discount.override','payments.reverse','expenses.approve','inventory.count.approve','reports.stock.read','reports.finance.read','audit.read'))
+  OR (r.name = 'Gestionnaire de stock' AND (p.code LIKE 'products.%' OR p.code LIKE 'inventory.%' OR p.code = 'reports.stock.read'))
+  OR (r.name = 'Responsable achats' AND (p.code LIKE 'purchases.%' OR p.code IN ('products.read','inventory.read')))
+  OR (r.name = 'Vendeur / Caissier' AND p.code IN ('products.read','inventory.read','sales.create','sales.validate','payments.record'))
+  OR (r.name = 'Comptable' AND p.code IN ('payments.record','payments.reverse','expenses.create','expenses.approve','reports.finance.read','products.read'))
+  OR (r.name = 'Auditeur' AND p.code IN ('products.read','inventory.read','reports.stock.read','reports.finance.read','audit.read'))
+) WHERE r.is_system
+ON CONFLICT DO NOTHING;
diff -ruN -x node_modules -x tsconfig.tsbuildinfo orig/Gestion_de_Stock-main/db/0011_transfers_functions.sql Gestion_de_Stock-main/db/0011_transfers_functions.sql
--- orig/Gestion_de_Stock-main/db/0011_transfers_functions.sql	1970-01-01 00:00:00.000000000 +0000
+++ Gestion_de_Stock-main/db/0011_transfers_functions.sql	2026-10-22 11:30:30.640406476 +0000
@@ -0,0 +1,99 @@
+-- 0011 : transferts entre entrepôts.
+-- 1) Le stock total d'un produit (products.quantity) reste la somme « entrepôts + en transit ».
+--    Le déclencheur applique donc la VARIATION de products.quantity à l'entrepôt par défaut
+--    (l'ancienne version recopiait le total, ce qui devient faux dès qu'un 2e entrepôt a du stock).
+-- 2) Deux nouveaux types de mouvement : transfer_out / transfer_in.
+-- 3) Fonctions atomiques ship_transfer / receive_transfer / cancel_transfer.
+
+CREATE OR REPLACE FUNCTION sync_stock_balance() RETURNS trigger LANGUAGE plpgsql AS $$
+DECLARE
+  delta numeric;
+  wh uuid;
+BEGIN
+  IF TG_OP = 'INSERT' THEN
+    delta := NEW.quantity;
+  ELSE
+    delta := NEW.quantity - OLD.quantity;
+  END IF;
+  IF delta = 0 THEN RETURN NULL; END IF;
+  SELECT id INTO wh FROM warehouses WHERE company_id = NEW.company_id AND is_default;
+  IF wh IS NULL THEN RETURN NULL; END IF;
+  -- UPDATE d'abord : un INSERT ... ON CONFLICT contrôle la ligne proposée (variation négative) avant le conflit.
+  UPDATE stock_balances SET quantity_on_hand = quantity_on_hand + delta, updated_at = now()
+   WHERE company_id = NEW.company_id AND warehouse_id = wh AND product_id = NEW.id;
+  IF NOT FOUND THEN
+    INSERT INTO stock_balances (company_id, warehouse_id, product_id, quantity_on_hand)
+    VALUES (NEW.company_id, wh, NEW.id, delta);
+  END IF;
+  RETURN NULL;
+END
+$$;
+
+ALTER TABLE stock_movements DROP CONSTRAINT IF EXISTS stock_movements_movement_type_check;
+ALTER TABLE stock_movements ADD CONSTRAINT stock_movements_movement_type_check
+  CHECK (movement_type::text = ANY (ARRAY['in','out','adjustment','transfer_out','transfer_in']));
+
+CREATE OR REPLACE FUNCTION ship_transfer(p_company uuid, p_transfer uuid, p_user bigint) RETURNS void
+LANGUAGE plpgsql AS $$
+DECLARE
+  t stock_transfers%ROWTYPE;
+  l RECORD;
+BEGIN
+  SELECT * INTO t FROM stock_transfers WHERE id = p_transfer AND company_id = p_company FOR UPDATE;
+  IF NOT FOUND THEN RAISE EXCEPTION 'TRANSFER_NOT_FOUND'; END IF;
+  IF t.status <> 'draft' THEN RAISE EXCEPTION 'TRANSFER_BAD_STATUS'; END IF;
+  IF NOT EXISTS (SELECT 1 FROM stock_transfer_lines WHERE transfer_id = p_transfer AND company_id = p_company) THEN
+    RAISE EXCEPTION 'TRANSFER_EMPTY';
+  END IF;
+  FOR l IN SELECT id, product_id, quantity_requested FROM stock_transfer_lines
+           WHERE transfer_id = p_transfer AND company_id = p_company ORDER BY product_id LOOP
+    UPDATE stock_balances
+       SET quantity_on_hand = quantity_on_hand - l.quantity_requested, updated_at = now()
+     WHERE company_id = p_company AND warehouse_id = t.source_warehouse_id AND product_id = l.product_id
+       AND quantity_on_hand - quantity_reserved >= l.quantity_requested;
+    IF NOT FOUND THEN RAISE EXCEPTION 'INSUFFICIENT_STOCK:%', l.product_id; END IF;
+    UPDATE stock_transfer_lines SET quantity_shipped = l.quantity_requested WHERE id = l.id;
+    INSERT INTO stock_movements (company_id, product_id, movement_type, quantity, note, user_id, warehouse_id, source_type, source_id)
+    VALUES (p_company, l.product_id, 'transfer_out', l.quantity_requested::int, 'Transfert ' || t.transfer_number, p_user, t.source_warehouse_id, 'transfer', p_transfer::text);
+  END LOOP;
+  UPDATE stock_transfers SET status = 'shipped', shipped_at = now() WHERE id = p_transfer;
+END
+$$;
+
+CREATE OR REPLACE FUNCTION receive_transfer(p_company uuid, p_transfer uuid, p_user bigint) RETURNS void
+LANGUAGE plpgsql AS $$
+DECLARE
+  t stock_transfers%ROWTYPE;
+  l RECORD;
+  remaining numeric;
+BEGIN
+  SELECT * INTO t FROM stock_transfers WHERE id = p_transfer AND company_id = p_company FOR UPDATE;
+  IF NOT FOUND THEN RAISE EXCEPTION 'TRANSFER_NOT_FOUND'; END IF;
+  IF t.status <> 'shipped' THEN RAISE EXCEPTION 'TRANSFER_BAD_STATUS'; END IF;
+  FOR l IN SELECT id, product_id, quantity_shipped, quantity_received FROM stock_transfer_lines
+           WHERE transfer_id = p_transfer AND company_id = p_company ORDER BY product_id LOOP
+    remaining := l.quantity_shipped - l.quantity_received;
+    IF remaining <= 0 THEN CONTINUE; END IF;
+    INSERT INTO stock_balances (company_id, warehouse_id, product_id, quantity_on_hand)
+    VALUES (p_company, t.destination_warehouse_id, l.product_id, remaining)
+    ON CONFLICT (company_id, warehouse_id, product_id)
+    DO UPDATE SET quantity_on_hand = stock_balances.quantity_on_hand + EXCLUDED.quantity_on_hand, updated_at = now();
+    UPDATE stock_transfer_lines SET quantity_received = quantity_shipped WHERE id = l.id;
+    INSERT INTO stock_movements (company_id, product_id, movement_type, quantity, note, user_id, warehouse_id, source_type, source_id)
+    VALUES (p_company, l.product_id, 'transfer_in', remaining::int, 'Transfert ' || t.transfer_number, p_user, t.destination_warehouse_id, 'transfer', p_transfer::text);
+  END LOOP;
+  UPDATE stock_transfers SET status = 'received', received_at = now() WHERE id = p_transfer;
+END
+$$;
+
+CREATE OR REPLACE FUNCTION cancel_transfer(p_company uuid, p_transfer uuid) RETURNS void
+LANGUAGE plpgsql AS $$
+DECLARE
+  t stock_transfers%ROWTYPE;
+BEGIN
+  SELECT * INTO t FROM stock_transfers WHERE id = p_transfer AND company_id = p_company FOR UPDATE;
+  IF NOT FOUND THEN RAISE EXCEPTION 'TRANSFER_NOT_FOUND'; END IF;
+  IF t.status <> 'draft' THEN RAISE EXCEPTION 'TRANSFER_BAD_STATUS'; END IF;
+  UPDATE stock_transfers SET status = 'cancelled' WHERE id = p_transfer;
+END
+$$;
diff -ruN -x node_modules -x tsconfig.tsbuildinfo orig/Gestion_de_Stock-main/db/0012_inventory_counts.sql Gestion_de_Stock-main/db/0012_inventory_counts.sql
--- orig/Gestion_de_Stock-main/db/0012_inventory_counts.sql	1970-01-01 00:00:00.000000000 +0000
+++ Gestion_de_Stock-main/db/0012_inventory_counts.sql	2026-10-23 07:54:48.490293615 +0000
@@ -0,0 +1,73 @@
+-- 0012 : inventaires physiques.
+-- 1) Une seule session d'inventaire active (ouverte ou soumise) par entrepôt.
+-- 2) Le déclencheur de soldes peut être suspendu (app.skip_stock_sync) par les fonctions
+--    qui règlent elles-mêmes les soldes par entrepôt.
+-- 3) approve_inventory_count : applique les écarts (compté - attendu) à l'entrepôt de l'inventaire,
+--    met à jour le total du produit et journalise un mouvement « adjustment » par écart.
+
+CREATE UNIQUE INDEX IF NOT EXISTS inventory_counts_one_active_idx
+  ON inventory_counts (company_id, warehouse_id) WHERE status IN ('open','submitted');
+
+CREATE OR REPLACE FUNCTION sync_stock_balance() RETURNS trigger LANGUAGE plpgsql AS $$
+DECLARE
+  delta numeric;
+  wh uuid;
+BEGIN
+  -- Les fonctions qui règlent elles-mêmes les soldes par entrepôt (inventaire) désactivent la synchronisation.
+  IF current_setting('app.skip_stock_sync', true) = '1' THEN RETURN NULL; END IF;
+  IF TG_OP = 'INSERT' THEN
+    delta := NEW.quantity;
+  ELSE
+    delta := NEW.quantity - OLD.quantity;
+  END IF;
+  IF delta = 0 THEN RETURN NULL; END IF;
+  SELECT id INTO wh FROM warehouses WHERE company_id = NEW.company_id AND is_default;
+  IF wh IS NULL THEN RETURN NULL; END IF;
+  -- UPDATE d'abord : un INSERT ... ON CONFLICT contrôle la ligne proposée (variation négative) avant le conflit.
+  UPDATE stock_balances SET quantity_on_hand = quantity_on_hand + delta, updated_at = now()
+   WHERE company_id = NEW.company_id AND warehouse_id = wh AND product_id = NEW.id;
+  IF NOT FOUND THEN
+    INSERT INTO stock_balances (company_id, warehouse_id, product_id, quantity_on_hand)
+    VALUES (NEW.company_id, wh, NEW.id, delta);
+  END IF;
+  RETURN NULL;
+END
+$$;
+
+CREATE OR REPLACE FUNCTION approve_inventory_count(p_company uuid, p_count uuid, p_user bigint) RETURNS int
+LANGUAGE plpgsql AS $$
+DECLARE
+  c inventory_counts%ROWTYPE;
+  l RECORD;
+  v numeric;
+  adjusted int := 0;
+BEGIN
+  SELECT * INTO c FROM inventory_counts WHERE id = p_count AND company_id = p_company FOR UPDATE;
+  IF NOT FOUND THEN RAISE EXCEPTION 'INVENTORY_NOT_FOUND'; END IF;
+  IF c.status <> 'submitted' THEN RAISE EXCEPTION 'INVENTORY_BAD_STATUS'; END IF;
+  -- Soldes par entrepôt réglés ici ; products.quantity (total) suit la même variation.
+  PERFORM set_config('app.skip_stock_sync', '1', true);
+  FOR l IN SELECT product_id, expected_quantity, counted_quantity FROM inventory_count_lines
+           WHERE count_id = p_count AND company_id = p_company
+             AND counted_quantity IS NOT NULL AND counted_quantity <> expected_quantity
+           ORDER BY product_id LOOP
+    v := l.counted_quantity - l.expected_quantity;
+    UPDATE stock_balances SET quantity_on_hand = quantity_on_hand + v, updated_at = now()
+     WHERE company_id = p_company AND warehouse_id = c.warehouse_id AND product_id = l.product_id;
+    IF NOT FOUND THEN
+      IF v < 0 THEN RAISE EXCEPTION 'INVENTORY_STOCK_CHANGED:%', l.product_id; END IF;
+      INSERT INTO stock_balances (company_id, warehouse_id, product_id, quantity_on_hand)
+      VALUES (p_company, c.warehouse_id, l.product_id, v);
+    END IF;
+    UPDATE products SET quantity = quantity + v WHERE id = l.product_id AND company_id = p_company;
+    INSERT INTO stock_movements (company_id, product_id, movement_type, quantity, note, user_id, warehouse_id, source_type, source_id)
+    VALUES (p_company, l.product_id, 'adjustment', ABS(v)::int,
+            'Inventaire ' || c.count_number || ' : ' || l.expected_quantity::int || ' → ' || l.counted_quantity::int,
+            p_user, c.warehouse_id, 'inventory_count', p_count::text);
+    adjusted := adjusted + 1;
+  END LOOP;
+  PERFORM set_config('app.skip_stock_sync', '', true);
+  UPDATE inventory_counts SET status = 'approved', approved_by = p_user, approved_at = now() WHERE id = p_count;
+  RETURN adjusted;
+END
+$$;
diff -ruN -x node_modules -x tsconfig.tsbuildinfo orig/Gestion_de_Stock-main/db/0013_purchase_workflow_receipts.sql Gestion_de_Stock-main/db/0013_purchase_workflow_receipts.sql
--- orig/Gestion_de_Stock-main/db/0013_purchase_workflow_receipts.sql	1970-01-01 00:00:00.000000000 +0000
+++ Gestion_de_Stock-main/db/0013_purchase_workflow_receipts.sql	2026-10-26 10:46:39.979481428 +0000
@@ -0,0 +1,112 @@
+-- 0013 : achats — approbation optionnelle des commandes et réceptions partielles.
+-- Statuts de commande : draft -> submitted -> ordered -> partially_received -> received (ou cancelled).
+-- « ordered » = commande approuvée / passée, prête à être réceptionnée (statut déjà utilisé par l'application).
+-- Les commandes existantes ne changent pas. Idempotente.
+
+UPDATE purchase_order_items i SET quantity_received = i.quantity
+FROM purchase_orders o WHERE o.id = i.order_id AND o.status = 'received' AND i.quantity_received = 0;
+
+ALTER TABLE purchase_order_items ADD COLUMN IF NOT EXISTS quantity_received integer NOT NULL DEFAULT 0;
+ALTER TABLE purchase_order_items ADD COLUMN IF NOT EXISTS quantity_rejected integer NOT NULL DEFAULT 0;
+ALTER TABLE purchase_order_items DROP CONSTRAINT IF EXISTS purchase_order_items_receipt_check;
+ALTER TABLE purchase_order_items ADD CONSTRAINT purchase_order_items_receipt_check
+  CHECK (quantity_received >= 0 AND quantity_rejected >= 0 AND quantity_received + quantity_rejected <= quantity);
+
+ALTER TABLE purchase_orders
+  ADD COLUMN IF NOT EXISTS order_number text,
+  ADD COLUMN IF NOT EXISTS submitted_at timestamptz,
+  ADD COLUMN IF NOT EXISTS approved_by bigint REFERENCES users(id),
+  ADD COLUMN IF NOT EXISTS approved_at timestamptz;
+CREATE UNIQUE INDEX IF NOT EXISTS purchase_orders_number_idx ON purchase_orders (company_id, order_number) WHERE order_number IS NOT NULL;
+
+ALTER TABLE purchase_orders DROP CONSTRAINT IF EXISTS purchase_orders_status_check;
+ALTER TABLE purchase_orders ADD CONSTRAINT purchase_orders_status_check
+  CHECK (status::text = ANY (ARRAY['draft','submitted','ordered','partially_received','received','cancelled']));
+
+CREATE TABLE IF NOT EXISTS goods_receipts (
+  id uuid PRIMARY KEY DEFAULT gen_random_uuid(),
+  company_id uuid NOT NULL REFERENCES companies(id),
+  order_id bigint NOT NULL,
+  receipt_number text NOT NULL,
+  note text,
+  received_by bigint REFERENCES users(id),
+  received_at timestamptz NOT NULL DEFAULT now(),
+  UNIQUE (id, company_id),
+  UNIQUE (company_id, receipt_number),
+  FOREIGN KEY (order_id, company_id) REFERENCES purchase_orders(id, company_id)
+);
+CREATE INDEX IF NOT EXISTS goods_receipts_order_idx ON goods_receipts (company_id, order_id);
+
+CREATE TABLE IF NOT EXISTS goods_receipt_lines (
+  id uuid PRIMARY KEY DEFAULT gen_random_uuid(),
+  company_id uuid NOT NULL REFERENCES companies(id),
+  receipt_id uuid NOT NULL,
+  order_item_id bigint NOT NULL REFERENCES purchase_order_items(id),
+  product_id bigint NOT NULL,
+  quantity_received integer NOT NULL CHECK (quantity_received >= 0),
+  quantity_rejected integer NOT NULL CHECK (quantity_rejected >= 0),
+  CHECK (quantity_received + quantity_rejected > 0),
+  FOREIGN KEY (receipt_id, company_id) REFERENCES goods_receipts(id, company_id) ON DELETE CASCADE,
+  FOREIGN KEY (product_id, company_id) REFERENCES products(id, company_id)
+);
+
+-- Réception atomique, complète ou partielle. p_lines = [{"itemId":…, "received":…, "rejected":…}] ;
+-- NULL = tout le reste à recevoir. Le stock n'augmente que des quantités reçues (pas des rejetées).
+CREATE OR REPLACE FUNCTION receive_purchase(p_company uuid, p_order bigint, p_user bigint, p_lines jsonb, p_note text) RETURNS text
+LANGUAGE plpgsql AS $$
+DECLARE
+  o purchase_orders%ROWTYPE;
+  x RECORD;
+  it purchase_order_items%ROWTYPE;
+  rid uuid := gen_random_uuid();
+  seq bigint;
+  rnum text;
+  touched int := 0;
+BEGIN
+  SELECT * INTO o FROM purchase_orders WHERE id = p_order AND company_id = p_company FOR UPDATE;
+  IF NOT FOUND THEN RAISE EXCEPTION 'PURCHASE_NOT_FOUND'; END IF;
+  IF o.status NOT IN ('ordered', 'partially_received') THEN RAISE EXCEPTION 'PURCHASE_BAD_STATUS'; END IF;
+
+  IF p_lines IS NULL THEN
+    SELECT jsonb_agg(jsonb_build_object('itemId', id, 'received', quantity - quantity_received - quantity_rejected, 'rejected', 0))
+      INTO p_lines FROM purchase_order_items WHERE order_id = p_order;
+  END IF;
+
+  INSERT INTO document_sequences (company_id, document_type, period, next_value)
+  VALUES (p_company, 'goods_receipt', to_char(now(), 'YYYY'), 2)
+  ON CONFLICT (company_id, document_type, period) DO UPDATE SET next_value = document_sequences.next_value + 1
+  RETURNING next_value - 1 INTO seq;
+  rnum := 'REC-' || to_char(now(), 'YYYY') || '-' || lpad(seq::text, 5, '0');
+
+  INSERT INTO goods_receipts (id, company_id, order_id, receipt_number, note, received_by)
+  VALUES (rid, p_company, p_order, rnum, p_note, p_user);
+
+  FOR x IN SELECT (e->>'itemId')::bigint AS item_id, COALESCE((e->>'received')::int, 0) AS rec, COALESCE((e->>'rejected')::int, 0) AS rej
+           FROM jsonb_array_elements(p_lines) e ORDER BY 1 LOOP
+    IF x.rec < 0 OR x.rej < 0 THEN RAISE EXCEPTION 'RECEIPT_INVALID'; END IF;
+    IF x.rec = 0 AND x.rej = 0 THEN CONTINUE; END IF;
+    SELECT * INTO it FROM purchase_order_items WHERE id = x.item_id AND order_id = p_order FOR UPDATE;
+    IF NOT FOUND THEN RAISE EXCEPTION 'RECEIPT_INVALID'; END IF;
+    IF x.rec + x.rej > it.quantity - it.quantity_received - it.quantity_rejected THEN
+      RAISE EXCEPTION 'RECEIPT_EXCEEDS:%', it.product_id;
+    END IF;
+    UPDATE purchase_order_items SET quantity_received = quantity_received + x.rec, quantity_rejected = quantity_rejected + x.rej WHERE id = it.id;
+    INSERT INTO goods_receipt_lines (company_id, receipt_id, order_item_id, product_id, quantity_received, quantity_rejected)
+    VALUES (p_company, rid, it.id, it.product_id, x.rec, x.rej);
+    IF x.rec > 0 THEN
+      UPDATE products SET quantity = quantity + x.rec, updated_at = now() WHERE id = it.product_id AND company_id = p_company;
+      INSERT INTO stock_movements (company_id, product_id, movement_type, quantity, note, user_id, supplier_id, source_type, source_id)
+      VALUES (p_company, it.product_id, 'in', x.rec, 'Réception ' || rnum || ' (commande #' || p_order || ')', p_user, o.supplier_id, 'goods_receipt', rid::text);
+    END IF;
+    touched := touched + 1;
+  END LOOP;
+  IF touched = 0 THEN RAISE EXCEPTION 'RECEIPT_EMPTY'; END IF;
+
+  IF EXISTS (SELECT 1 FROM purchase_order_items WHERE order_id = p_order AND quantity_received + quantity_rejected < quantity) THEN
+    UPDATE purchase_orders SET status = 'partially_received' WHERE id = p_order;
+  ELSE
+    UPDATE purchase_orders SET status = 'received', received_at = now() WHERE id = p_order;
+  END IF;
+  RETURN rnum;
+END
+$$;
diff -ruN -x node_modules -x tsconfig.tsbuildinfo orig/Gestion_de_Stock-main/db/0014_rbac_alignment.sql Gestion_de_Stock-main/db/0014_rbac_alignment.sql
--- orig/Gestion_de_Stock-main/db/0014_rbac_alignment.sql	1970-01-01 00:00:00.000000000 +0000
+++ Gestion_de_Stock-main/db/0014_rbac_alignment.sql	2026-10-26 11:33:41.427695116 +0000
@@ -0,0 +1,43 @@
+-- 0014 : alignement des droits RBAC sur le comportement actuel de l'application.
+-- Les permissions sont désormais lues depuis la base (roles -> role_permissions -> permissions).
+-- Cette migration ajoute les codes manquants et ajuste les rôles système pour qu'aucun
+-- utilisateur existant ne perde (ni ne gagne, hors cas listés dans le README) un droit.
+-- Additive côté permissions ; idempotente.
+
+INSERT INTO permissions (code, description) VALUES
+  ('sales.cancel', 'Annuler une vente'),
+  ('inventory.movements.read', 'Consulter le journal des mouvements'),
+  ('inventory.count.read', 'Consulter les inventaires'),
+  ('inventory.transfer.read', 'Consulter les transferts')
+ON CONFLICT (code) DO NOTHING;
+
+-- Administrateur entreprise : toutes les permissions du catalogue.
+INSERT INTO role_permissions (role_id, permission_id)
+SELECT r.id, p.id FROM roles r CROSS JOIN permissions p
+WHERE r.is_system AND r.name = 'Administrateur entreprise'
+ON CONFLICT DO NOTHING;
+
+-- Autres rôles : droits ajoutés.
+WITH grants(role_name, code) AS (VALUES
+  ('Directeur', 'sales.cancel'), ('Directeur', 'inventory.movements.read'), ('Directeur', 'inventory.count.read'),
+  ('Directeur', 'inventory.transfer.read'), ('Directeur', 'products.create'), ('Directeur', 'products.update'),
+  ('Directeur', 'products.archive'), ('Directeur', 'inventory.adjust'), ('Directeur', 'inventory.count'),
+  ('Directeur', 'inventory.transfer.create'), ('Directeur', 'inventory.transfer.ship'), ('Directeur', 'inventory.transfer.receive'),
+  ('Directeur', 'warehouses.manage'), ('Directeur', 'suppliers.manage'), ('Directeur', 'customers.manage'),
+  ('Directeur', 'sales.create'), ('Directeur', 'purchases.create'), ('Directeur', 'purchases.submit'),
+  ('Directeur', 'purchases.cancel'), ('Directeur', 'purchases.receive'),
+  ('Gestionnaire de stock', 'inventory.movements.read'), ('Gestionnaire de stock', 'inventory.count.read'),
+  ('Gestionnaire de stock', 'inventory.transfer.read'), ('Gestionnaire de stock', 'purchases.read'),
+  ('Gestionnaire de stock', 'purchases.receive'),
+  ('Auditeur', 'inventory.movements.read'), ('Auditeur', 'inventory.count.read'), ('Auditeur', 'inventory.transfer.read')
+)
+INSERT INTO role_permissions (role_id, permission_id)
+SELECT r.id, p.id FROM grants g
+JOIN roles r ON r.is_system AND r.name = g.role_name
+JOIN permissions p ON p.code = g.code
+ON CONFLICT DO NOTHING;
+
+-- L'approbation d'un inventaire revient au responsable, pas au gestionnaire de stock (cahier des charges 4.1).
+DELETE FROM role_permissions rp USING roles r, permissions p
+WHERE rp.role_id = r.id AND rp.permission_id = p.id
+  AND r.is_system AND r.name = 'Gestionnaire de stock' AND p.code = 'inventory.count.approve';
diff -ruN -x node_modules -x tsconfig.tsbuildinfo orig/Gestion_de_Stock-main/db/0015_user_avatars.sql Gestion_de_Stock-main/db/0015_user_avatars.sql
--- orig/Gestion_de_Stock-main/db/0015_user_avatars.sql	1970-01-01 00:00:00.000000000 +0000
+++ Gestion_de_Stock-main/db/0015_user_avatars.sql	2026-10-26 19:40:12.001698593 +0000
@@ -0,0 +1,10 @@
+-- 0015 : photo de profil des utilisateurs.
+-- L'image (JPEG, PNG ou WebP, redimensionnée en 256×256 côté navigateur) est stockée en base64 dans une table
+-- dédiée : elle ne dépend pas du système de fichiers éphémère de Vercel (cahier des charges 8.4) et ne ralentit
+-- pas la table users. Additive, idempotente.
+CREATE TABLE IF NOT EXISTS user_avatars (
+  user_id bigint PRIMARY KEY REFERENCES users(id) ON DELETE CASCADE,
+  content_type text NOT NULL CHECK (content_type IN ('image/jpeg', 'image/png', 'image/webp')),
+  data_base64 text NOT NULL CHECK (length(data_base64) BETWEEN 100 AND 400000),
+  updated_at timestamptz NOT NULL DEFAULT now()
+);
diff -ruN -x node_modules -x tsconfig.tsbuildinfo orig/Gestion_de_Stock-main/db/0016_payments.sql Gestion_de_Stock-main/db/0016_payments.sql
--- orig/Gestion_de_Stock-main/db/0016_payments.sql	1970-01-01 00:00:00.000000000 +0000
+++ Gestion_de_Stock-main/db/0016_payments.sql	2026-10-27 01:40:00.452595311 +0000
@@ -0,0 +1,249 @@
+-- 0016 : module Paiements (cahier des charges 3.8, 5.2 Finance, 7.6).
+-- Modes de paiement par entreprise, paiements (encaissements et règlements), affectations aux documents,
+-- plafond de crédit client, soldes calculés depuis les paiements sources (vues sale_balances / purchase_balances).
+-- Un paiement validé n'est jamais supprimé : il est contrepassé (statut reversed).
+-- Idempotente.
+
+ALTER TABLE customers ADD COLUMN IF NOT EXISTS credit_limit numeric(19,4) CHECK (credit_limit IS NULL OR credit_limit >= 0);
+
+CREATE TABLE IF NOT EXISTS payment_methods (
+  id uuid PRIMARY KEY DEFAULT gen_random_uuid(),
+  company_id uuid NOT NULL REFERENCES companies(id),
+  code text NOT NULL CHECK (code ~ '^[a-z0-9_]{2,30}$'),
+  name text NOT NULL CHECK (length(btrim(name)) > 0),
+  type text NOT NULL CHECK (type IN ('cash','mobile_money','card','bank','other')),
+  status text NOT NULL DEFAULT 'active' CHECK (status IN ('active','inactive')),
+  UNIQUE (id, company_id),
+  UNIQUE (company_id, code)
+);
+
+INSERT INTO payment_methods (company_id, code, name, type)
+SELECT c.id, v.code, v.name, v.type
+FROM companies c
+CROSS JOIN (VALUES
+  ('cash', 'Espèces', 'cash'),
+  ('orange_money', 'Orange Money', 'mobile_money'),
+  ('mtn_money', 'MTN Mobile Money', 'mobile_money'),
+  ('card', 'Carte bancaire', 'card'),
+  ('bank_transfer', 'Virement bancaire', 'bank')
+) AS v(code, name, type)
+ON CONFLICT (company_id, code) DO NOTHING;
+
+CREATE TABLE IF NOT EXISTS payments (
+  id uuid PRIMARY KEY DEFAULT gen_random_uuid(),
+  company_id uuid NOT NULL REFERENCES companies(id),
+  payment_number text NOT NULL,
+  direction text NOT NULL CHECK (direction IN ('in','out')),
+  party_type text NOT NULL DEFAULT 'other' CHECK (party_type IN ('customer','supplier','other')),
+  customer_id bigint,
+  supplier_id bigint,
+  amount numeric(19,4) NOT NULL CHECK (amount > 0),
+  method_id uuid NOT NULL,
+  status text NOT NULL DEFAULT 'posted' CHECK (status IN ('pending','posted','failed','reversed')),
+  reference text,
+  provider text,
+  provider_reference text,
+  note text,
+  paid_at timestamptz NOT NULL DEFAULT now(),
+  created_by bigint REFERENCES users(id),
+  created_at timestamptz NOT NULL DEFAULT now(),
+  reversed_at timestamptz,
+  reversed_by bigint REFERENCES users(id),
+  reversal_reason text,
+  CHECK (customer_id IS NULL OR supplier_id IS NULL),
+  CHECK (party_type <> 'customer' OR customer_id IS NOT NULL),
+  CHECK (party_type <> 'supplier' OR supplier_id IS NOT NULL),
+  UNIQUE (id, company_id),
+  UNIQUE (company_id, payment_number),
+  FOREIGN KEY (customer_id, company_id) REFERENCES customers(id, company_id),
+  FOREIGN KEY (supplier_id, company_id) REFERENCES suppliers(id, company_id),
+  FOREIGN KEY (method_id, company_id) REFERENCES payment_methods(id, company_id)
+);
+CREATE UNIQUE INDEX IF NOT EXISTS payments_provider_ref_idx ON payments (company_id, provider, provider_reference) WHERE provider_reference IS NOT NULL;
+CREATE INDEX IF NOT EXISTS payments_list_idx ON payments (company_id, created_at DESC);
+CREATE INDEX IF NOT EXISTS payments_customer_idx ON payments (company_id, customer_id) WHERE customer_id IS NOT NULL;
+CREATE INDEX IF NOT EXISTS payments_supplier_idx ON payments (company_id, supplier_id) WHERE supplier_id IS NOT NULL;
+
+CREATE TABLE IF NOT EXISTS payment_allocations (
+  id uuid PRIMARY KEY DEFAULT gen_random_uuid(),
+  company_id uuid NOT NULL REFERENCES companies(id),
+  payment_id uuid NOT NULL,
+  document_type text NOT NULL CHECK (document_type IN ('sale','purchase_order')),
+  document_id bigint NOT NULL,
+  allocated_amount numeric(19,4) NOT NULL CHECK (allocated_amount > 0),
+  UNIQUE (payment_id, document_type, document_id),
+  FOREIGN KEY (payment_id, company_id) REFERENCES payments(id, company_id)
+);
+CREATE INDEX IF NOT EXISTS payment_allocations_doc_idx ON payment_allocations (company_id, document_type, document_id);
+
+-- Reprise de l'existant : chaque vente terminée a été réglée au comptoir, avec son mode de paiement.
+INSERT INTO payments (company_id, payment_number, direction, party_type, customer_id, amount, method_id, status, paid_at, created_by)
+SELECT s.company_id, 'PAY-LEG-' || s.id, 'in', CASE WHEN s.customer_id IS NULL THEN 'other' ELSE 'customer' END, s.customer_id,
+       s.total_amount, m.id, 'posted', s.created_at, s.user_id
+FROM sales s
+JOIN payment_methods m ON m.company_id = s.company_id AND m.code = s.payment_method
+WHERE s.status = 'completed' AND s.total_amount > 0
+  AND NOT EXISTS (SELECT 1 FROM payments p WHERE p.company_id = s.company_id AND p.payment_number = 'PAY-LEG-' || s.id);
+
+INSERT INTO payment_allocations (company_id, payment_id, document_type, document_id, allocated_amount)
+SELECT p.company_id, p.id, 'sale', substring(p.payment_number from 9)::bigint, p.amount
+FROM payments p
+WHERE p.payment_number LIKE 'PAY-LEG-%'
+ON CONFLICT (payment_id, document_type, document_id) DO NOTHING;
+
+-- Soldes calculés depuis les paiements sources (paid = validés ; pending = en attente de confirmation).
+CREATE OR REPLACE VIEW sale_balances AS
+SELECT s.company_id, s.id AS sale_id, s.customer_id, s.status, s.created_at, s.total_amount AS total,
+       COALESCE(x.paid, 0) AS paid, COALESCE(x.pending, 0) AS pending, s.total_amount - COALESCE(x.paid, 0) AS due
+FROM sales s
+LEFT JOIN LATERAL (
+  SELECT SUM(a.allocated_amount) FILTER (WHERE p.status = 'posted') AS paid,
+         SUM(a.allocated_amount) FILTER (WHERE p.status = 'pending') AS pending
+  FROM payment_allocations a
+  JOIN payments p ON p.id = a.payment_id AND p.company_id = a.company_id
+  WHERE a.company_id = s.company_id AND a.document_type = 'sale' AND a.document_id = s.id
+) x ON TRUE;
+
+CREATE OR REPLACE VIEW purchase_balances AS
+SELECT o.company_id, o.id AS order_id, o.supplier_id, o.status, o.created_at, o.total_cost AS total,
+       COALESCE(x.paid, 0) AS paid, COALESCE(x.pending, 0) AS pending, o.total_cost - COALESCE(x.paid, 0) AS due
+FROM purchase_orders o
+LEFT JOIN LATERAL (
+  SELECT SUM(a.allocated_amount) FILTER (WHERE p.status = 'posted') AS paid,
+         SUM(a.allocated_amount) FILTER (WHERE p.status = 'pending') AS pending
+  FROM payment_allocations a
+  JOIN payments p ON p.id = a.payment_id AND p.company_id = a.company_id
+  WHERE a.company_id = o.company_id AND a.document_type = 'purchase_order' AND a.document_id = o.id
+) x ON TRUE;
+
+-- Les nouvelles entreprises reçoivent les modes de paiement par défaut.
+CREATE OR REPLACE FUNCTION seed_payment_methods() RETURNS trigger LANGUAGE plpgsql AS $$
+BEGIN
+  INSERT INTO payment_methods (company_id, code, name, type) VALUES
+    (NEW.id, 'cash', 'Espèces', 'cash'),
+    (NEW.id, 'orange_money', 'Orange Money', 'mobile_money'),
+    (NEW.id, 'mtn_money', 'MTN Mobile Money', 'mobile_money'),
+    (NEW.id, 'card', 'Carte bancaire', 'card'),
+    (NEW.id, 'bank_transfer', 'Virement bancaire', 'bank')
+  ON CONFLICT (company_id, code) DO NOTHING;
+  RETURN NULL;
+END
+$$;
+DROP TRIGGER IF EXISTS companies_seed_payment_methods ON companies;
+CREATE TRIGGER companies_seed_payment_methods AFTER INSERT ON companies FOR EACH ROW EXECUTE FUNCTION seed_payment_methods();
+
+-- Enregistre un paiement et l'affecte à des documents, en une seule transaction.
+-- p_allocations = [{"documentType":"sale"|"purchase_order","documentId":123,"amount":456}, ...] (peut être vide :
+-- le paiement non affecté est conservé séparément, 7.6). p_status : 'posted' (défaut) ou 'pending' (opérateur mobile).
+-- Retourne {"id":…, "number":…, "allocated":…}.
+CREATE OR REPLACE FUNCTION record_payment(
+  p_company uuid, p_user bigint, p_direction text, p_customer bigint, p_supplier bigint, p_amount numeric,
+  p_method uuid, p_reference text, p_note text, p_allocations jsonb,
+  p_status text DEFAULT 'posted', p_provider text DEFAULT NULL, p_provider_reference text DEFAULT NULL
+) RETURNS jsonb LANGUAGE plpgsql AS $$
+DECLARE
+  pid uuid := gen_random_uuid();
+  seq bigint;
+  pnum text;
+  x RECORD;
+  doc_total numeric;
+  doc_party bigint;
+  doc_open boolean;
+  committed numeric;
+  allocated numeric := 0;
+  party text := 'other';
+BEGIN
+  IF p_direction NOT IN ('in', 'out') OR p_amount IS NULL OR p_amount <= 0 OR p_status NOT IN ('posted', 'pending') THEN
+    RAISE EXCEPTION 'PAYMENT_INVALID';
+  END IF;
+  IF NOT EXISTS (SELECT 1 FROM payment_methods WHERE id = p_method AND company_id = p_company AND status = 'active') THEN
+    RAISE EXCEPTION 'PAYMENT_METHOD_INVALID';
+  END IF;
+  IF p_customer IS NOT NULL AND p_supplier IS NOT NULL THEN RAISE EXCEPTION 'PAYMENT_INVALID'; END IF;
+  IF p_direction = 'in' AND p_supplier IS NOT NULL THEN RAISE EXCEPTION 'PAYMENT_INVALID'; END IF;
+  IF p_direction = 'out' AND p_customer IS NOT NULL THEN RAISE EXCEPTION 'PAYMENT_INVALID'; END IF;
+  IF p_customer IS NOT NULL THEN party := 'customer'; END IF;
+  IF p_supplier IS NOT NULL THEN party := 'supplier'; END IF;
+
+  INSERT INTO document_sequences (company_id, document_type, period, next_value)
+  VALUES (p_company, 'payment', to_char(now(), 'YYYY'), 2)
+  ON CONFLICT (company_id, document_type, period) DO UPDATE SET next_value = document_sequences.next_value + 1
+  RETURNING next_value - 1 INTO seq;
+  pnum := 'PAY-' || to_char(now(), 'YYYY') || '-' || lpad(seq::text, 5, '0');
+
+  INSERT INTO payments (id, company_id, payment_number, direction, party_type, customer_id, supplier_id, amount, method_id,
+                        status, reference, provider, provider_reference, note, created_by)
+  VALUES (pid, p_company, pnum, p_direction, party, p_customer, p_supplier, p_amount, p_method,
+          p_status, p_reference, p_provider, p_provider_reference, p_note, p_user);
+
+  FOR x IN SELECT e->>'documentType' AS dtype, (e->>'documentId')::bigint AS did, (e->>'amount')::numeric AS amt
+           FROM jsonb_array_elements(COALESCE(p_allocations, '[]'::jsonb)) e ORDER BY 1, 2 LOOP
+    IF x.amt IS NULL OR x.amt <= 0 THEN RAISE EXCEPTION 'PAYMENT_INVALID'; END IF;
+    IF x.dtype = 'sale' AND p_direction = 'in' THEN
+      SELECT total_amount, customer_id, (status = 'completed') INTO doc_total, doc_party, doc_open
+        FROM sales WHERE id = x.did AND company_id = p_company FOR UPDATE;
+    ELSIF x.dtype = 'purchase_order' AND p_direction = 'out' THEN
+      SELECT total_cost, supplier_id, (status IN ('ordered', 'partially_received', 'received')) INTO doc_total, doc_party, doc_open
+        FROM purchase_orders WHERE id = x.did AND company_id = p_company FOR UPDATE;
+    ELSE
+      RAISE EXCEPTION 'PAYMENT_INVALID';
+    END IF;
+    IF NOT FOUND THEN RAISE EXCEPTION 'PAYMENT_DOCUMENT_NOT_FOUND'; END IF;
+    IF NOT doc_open THEN RAISE EXCEPTION 'PAYMENT_DOCUMENT_CLOSED'; END IF;
+    IF (x.dtype = 'sale' AND p_customer IS NOT NULL AND doc_party IS DISTINCT FROM p_customer)
+       OR (x.dtype = 'purchase_order' AND p_supplier IS NOT NULL AND doc_party IS DISTINCT FROM p_supplier) THEN
+      RAISE EXCEPTION 'PAYMENT_PARTY_MISMATCH';
+    END IF;
+    SELECT COALESCE(SUM(a.allocated_amount), 0) INTO committed
+      FROM payment_allocations a JOIN payments p ON p.id = a.payment_id AND p.company_id = a.company_id
+      WHERE a.company_id = p_company AND a.document_type = x.dtype AND a.document_id = x.did AND p.status IN ('posted', 'pending');
+    IF x.amt > doc_total - committed THEN RAISE EXCEPTION 'PAYMENT_EXCEEDS_DUE:%', x.did; END IF;
+    INSERT INTO payment_allocations (company_id, payment_id, document_type, document_id, allocated_amount)
+    VALUES (p_company, pid, x.dtype, x.did, x.amt);
+    allocated := allocated + x.amt;
+  END LOOP;
+  IF allocated > p_amount THEN RAISE EXCEPTION 'PAYMENT_ALLOCATION_EXCEEDS'; END IF;
+  RETURN jsonb_build_object('id', pid, 'number', pnum, 'allocated', allocated);
+END
+$$;
+
+-- Contrepasse un paiement validé (jamais de suppression, 7.6).
+CREATE OR REPLACE FUNCTION reverse_payment(p_company uuid, p_payment uuid, p_user bigint, p_reason text) RETURNS void
+LANGUAGE plpgsql AS $$
+DECLARE
+  pay payments%ROWTYPE;
+BEGIN
+  SELECT * INTO pay FROM payments WHERE id = p_payment AND company_id = p_company FOR UPDATE;
+  IF NOT FOUND THEN RAISE EXCEPTION 'PAYMENT_NOT_FOUND'; END IF;
+  IF pay.status <> 'posted' THEN RAISE EXCEPTION 'PAYMENT_BAD_STATUS'; END IF;
+  UPDATE payments SET status = 'reversed', reversed_at = now(), reversed_by = p_user, reversal_reason = p_reason WHERE id = p_payment;
+END
+$$;
+
+-- Confirme ou échoue un paiement en attente (retour de l'opérateur de paiement).
+CREATE OR REPLACE FUNCTION settle_pending_payment(p_company uuid, p_payment uuid, p_success boolean, p_provider_reference text) RETURNS text
+LANGUAGE plpgsql AS $$
+DECLARE
+  pay payments%ROWTYPE;
+BEGIN
+  SELECT * INTO pay FROM payments WHERE id = p_payment AND company_id = p_company FOR UPDATE;
+  IF NOT FOUND THEN RAISE EXCEPTION 'PAYMENT_NOT_FOUND'; END IF;
+  IF pay.status <> 'pending' THEN RETURN pay.status; END IF;  -- rejeu d'une notification : sans effet
+  UPDATE payments SET status = CASE WHEN p_success THEN 'posted' ELSE 'failed' END,
+         provider_reference = COALESCE(p_provider_reference, provider_reference), paid_at = now()
+   WHERE id = p_payment;
+  RETURN CASE WHEN p_success THEN 'posted' ELSE 'failed' END;
+END
+$$;
+
+-- Droits de consultation et de contrepassation des paiements (cahier des charges 4.1), idempotent.
+WITH grants(role_name, code) AS (VALUES
+  ('Vendeur / Caissier', 'payments.read'),
+  ('Directeur', 'payments.read'),
+  ('Directeur', 'payments.reverse')
+)
+INSERT INTO role_permissions (role_id, permission_id)
+SELECT r.id, p.id FROM grants g
+JOIN roles r ON r.is_system AND r.name = g.role_name
+JOIN permissions p ON p.code = g.code
+ON CONFLICT DO NOTHING;
