diff -ruN -x node_modules -x tsconfig.tsbuildinfo orig/Gestion_de_Stock-main/app/api/payments/mobile/route.ts Gestion_de_Stock-main/app/api/payments/mobile/route.ts
--- orig/Gestion_de_Stock-main/app/api/payments/mobile/route.ts	1970-01-01 00:00:00.000000000 +0000
+++ Gestion_de_Stock-main/app/api/payments/mobile/route.ts	2026-10-28 01:45:18.476061092 +0000
@@ -0,0 +1,121 @@
+import { NextResponse } from "next/server";
+import { getSql } from "@/lib/db";
+import { authorize, logAudit } from "@/lib/auth";
+import { rolesFor } from "@/lib/roles";
+import { fail, idempotencyKey, isForeignKey, isUnique, parseBody, paymentFailure, serverError } from "@/lib/api";
+import { mobilePaymentSchema } from "@/lib/validation";
+import { isConfigured, mtnRequestToPay, newExternalId, normalizeCameroonPhone, orangeInit, ProviderError, providerStatus } from "@/lib/payments/mobile";
+
+export const runtime = "nodejs";
+export const maxDuration = 30;
+
+/**
+ * Encaissement d'une vente par Orange Money ou MTN MoMo.
+ * 1) le paiement est créé « en attente » (montant réservé sur la vente) avec sa session, en une seule transaction ;
+ * 2) la demande part chez l'opérateur ; 3) le règlement final vient de la relecture du statut chez l'opérateur.
+ */
+export async function POST(request: Request) {
+  const auth = await authorize(request, rolesFor("payments.write"));
+  if ("error" in auth) return auth.error;
+  const body = await parseBody(request, mobilePaymentSchema);
+  if ("error" in body) return body.error;
+  const d = body.data;
+
+  if (!isConfigured(d.provider)) {
+    const missing = providerStatus()[d.provider].missing.join(", ");
+    return fail(`Ce mode de paiement n’est pas encore connecté. Variables à renseigner : ${missing}.`, 503);
+  }
+  const total = d.allocations.reduce((sum, a) => sum + a.amount, 0);
+  if (Math.round(total * 100) !== Math.round(d.amount * 100)) return fail("Le montant doit correspondre à la somme affectée aux ventes.", 400);
+
+  let phone: string | null = null;
+  if (d.provider === "mtn_money") {
+    try {
+      phone = normalizeCameroonPhone(d.phone ?? "");
+    } catch (error) {
+      return fail(error instanceof ProviderError ? error.message : "Numéro invalide.", 400);
+    }
+  }
+
+  const idem = idempotencyKey(request);
+  if ("error" in idem) return idem.error;
+  const key = idem.key;
+  const companyId = auth.user.companyId;
+  const externalId = newExternalId(d.provider);
+  const allocations = JSON.stringify(d.allocations);
+  const reference = d.reference?.trim() ? d.reference.trim() : null;
+
+  async function replay() {
+    if (!key) return null;
+    const sql = getSql();
+    const found = await sql`
+      SELECT p.id, p.payment_number AS number, p.status, s.payment_url AS "paymentUrl", s.provider
+      FROM idempotency_keys k
+      JOIN payments p ON p.id = k.result_reference::uuid AND p.company_id = k.company_id
+      LEFT JOIN payment_provider_sessions s ON s.payment_id = p.id
+      WHERE k.company_id = ${companyId}::uuid AND k.key = ${key} AND k.operation = 'mobile_payment_create'`;
+    return found[0] ?? null;
+  }
+
+  let created: { id: string; number: string };
+  try {
+    const previous = await replay();
+    if (previous) return NextResponse.json({ payment: { id: previous.id, number: previous.number, status: previous.status, paymentUrl: previous.paymentUrl }, replayed: true });
+    const sql = getSql();
+    const rows = await sql`
+      WITH r AS (
+        SELECT record_payment(
+          ${companyId}::uuid, ${auth.user.id}::bigint, 'in', ${d.customerId ?? null}::bigint, NULL::bigint, ${d.amount}::numeric,
+          (SELECT m.id FROM payment_methods m WHERE m.company_id = ${companyId}::uuid AND m.code = ${d.provider}::text AND m.status = 'active'),
+          ${reference}::text, NULL::text, ${allocations}::jsonb, 'pending', ${d.provider}::text, ${externalId}::text
+        ) AS res
+      ), s AS (
+        INSERT INTO payment_provider_sessions (company_id, payment_id, provider, external_id, phone)
+        SELECT ${companyId}::uuid, (r.res->>'id')::uuid, ${d.provider}::text, ${externalId}::text, ${phone}::text FROM r
+        RETURNING 1
+      ), k AS (
+        INSERT INTO idempotency_keys (company_id, key, operation, result_reference)
+        SELECT ${companyId}::uuid, ${key}::text, 'mobile_payment_create', r.res->>'id' FROM r WHERE ${key}::text IS NOT NULL
+        RETURNING 1
+      )
+      SELECT res FROM r`;
+    created = rows[0].res as { id: string; number: string };
+  } catch (error) {
+    if (isUnique(error) && key) {
+      const previous = await replay().catch(() => null);
+      if (previous) return NextResponse.json({ payment: { id: previous.id, number: previous.number, status: previous.status, paymentUrl: previous.paymentUrl }, replayed: true });
+    }
+    if (isForeignKey(error)) return fail("Client invalide.", 400);
+    return paymentFailure(error) ?? serverError("Impossible de préparer l’encaissement.");
+  }
+
+  const sql = getSql();
+  try {
+    let paymentUrl: string | null = null;
+    if (d.provider === "mtn_money" && phone) {
+      await mtnRequestToPay({ referenceId: externalId, amount: d.amount, phone, message: `Paiement ${created.number}` });
+      await sql`UPDATE payment_provider_sessions SET last_status = 'pending' WHERE payment_id = ${created.id}::uuid`;
+    } else {
+      const order = await orangeInit({ orderId: externalId, amount: d.amount, reference: created.number });
+      paymentUrl = order.paymentUrl;
+      await sql`
+        UPDATE payment_provider_sessions SET last_status = 'pending', pay_token = ${order.payToken}, notif_token = ${order.notifToken ?? null}, payment_url = ${order.paymentUrl}
+        WHERE payment_id = ${created.id}::uuid`;
+    }
+    await logAudit(auth.user.id, "mobile_payment_start", "payment", created.id, `${d.provider} ${d.amount}`);
+    return NextResponse.json({ payment: { id: created.id, number: created.number, status: "pending", paymentUrl } }, { status: 202 });
+  } catch (error) {
+    // La demande n'est pas partie : on libère le montant réservé.
+    const message = error instanceof ProviderError ? error.message : "La demande n’a pas pu être envoyée à l’opérateur.";
+    try {
+      // La fonction est appelée depuis la clause FROM : une sous-requête non utilisée ne serait pas exécutée.
+      await sql`
+        UPDATE payment_provider_sessions s SET last_status = 'failed', last_error = ${message}
+        FROM (SELECT settle_pending_payment(${companyId}::uuid, ${created.id}::uuid, FALSE, NULL::text) AS st) r
+        WHERE s.payment_id = ${created.id}::uuid`;
+    } catch {
+      // Le rapprochement quotidien réglera ce paiement en attente.
+    }
+    return fail(message, 502);
+  }
+}
diff -ruN -x node_modules -x tsconfig.tsbuildinfo orig/Gestion_de_Stock-main/app/api/payments/route.ts Gestion_de_Stock-main/app/api/payments/route.ts
--- orig/Gestion_de_Stock-main/app/api/payments/route.ts	1970-01-01 00:00:00.000000000 +0000
+++ Gestion_de_Stock-main/app/api/payments/route.ts	2026-10-27 01:39:16.220907563 +0000
@@ -0,0 +1,99 @@
+import { NextResponse } from "next/server";
+import { getSql } from "@/lib/db";
+import { authorize, logAudit } from "@/lib/auth";
+import { rolesFor } from "@/lib/roles";
+import { fail, idempotencyKey, isForeignKey, isUnique, parseBody, paymentFailure, serverError } from "@/lib/api";
+import { paymentSchema } from "@/lib/validation";
+
+export const runtime = "nodejs";
+
+export async function GET(request: Request) {
+  const auth = await authorize(request, rolesFor("payments.view"));
+  if ("error" in auth) return auth.error;
+  const params = new URL(request.url).searchParams;
+  const direction = params.get("direction");
+  const status = params.get("status");
+  try {
+    const sql = getSql();
+    const payments = await sql`
+      SELECT p.id, p.payment_number AS number, p.direction, p.status, p.amount, p.reference, p.provider, p.note,
+             p.paid_at AS "paidAt", p.reversal_reason AS "reversalReason",
+             m.name AS method, m.code AS "methodCode", COALESCE(c.name, s.name) AS party, u.name AS "createdBy",
+             COALESCE((SELECT SUM(a.allocated_amount) FROM payment_allocations a WHERE a.payment_id = p.id), 0) AS allocated
+      FROM payments p
+      JOIN payment_methods m ON m.id = p.method_id AND m.company_id = p.company_id
+      LEFT JOIN customers c ON c.id = p.customer_id AND c.company_id = p.company_id
+      LEFT JOIN suppliers s ON s.id = p.supplier_id AND s.company_id = p.company_id
+      LEFT JOIN users u ON u.id = p.created_by
+      WHERE p.company_id = ${auth.user.companyId}::uuid
+        AND (${direction}::text IS NULL OR p.direction = ${direction}::text)
+        AND (${status}::text IS NULL OR p.status = ${status}::text)
+      ORDER BY p.created_at DESC
+      LIMIT 200
+    `;
+    return NextResponse.json({ payments });
+  } catch {
+    return serverError();
+  }
+}
+
+/**
+ * Encaissement (direction « in ») ou règlement (« out »), affecté à des ventes ou des commandes.
+ * Tout se passe dans la fonction SQL record_payment ; la clé d'idempotence est enregistrée dans la même instruction.
+ */
+export async function POST(request: Request) {
+  const auth = await authorize(request, rolesFor("payments.write"));
+  if ("error" in auth) return auth.error;
+  const body = await parseBody(request, paymentSchema);
+  if ("error" in body) return body.error;
+  const d = body.data;
+  if (d.direction === "in" && d.supplierId) return fail("Un encaissement ne concerne pas un fournisseur.", 400);
+  if (d.direction === "out" && d.customerId) return fail("Un règlement ne concerne pas un client.", 400);
+  const idem = idempotencyKey(request);
+  if ("error" in idem) return idem.error;
+  const key = idem.key;
+  const companyId = auth.user.companyId;
+  const reference = d.reference?.trim() ? d.reference.trim() : null;
+  const note = d.note?.trim() ? d.note.trim() : null;
+  const allocations = JSON.stringify(d.allocations ?? []);
+
+  async function replay() {
+    if (!key) return null;
+    const sql = getSql();
+    const found = await sql`
+      SELECT p.id, p.payment_number AS number FROM idempotency_keys k
+      JOIN payments p ON p.id = k.result_reference::uuid AND p.company_id = k.company_id
+      WHERE k.company_id = ${companyId}::uuid AND k.key = ${key} AND k.operation = 'payment_create'
+    `;
+    return found[0] ?? null;
+  }
+
+  try {
+    const previous = await replay();
+    if (previous) return NextResponse.json({ payment: { id: previous.id, number: previous.number }, replayed: true });
+    const sql = getSql();
+    const rows = await sql`
+      WITH r AS (
+        SELECT record_payment(
+          ${companyId}::uuid, ${auth.user.id}::bigint, ${d.direction}::text, ${d.customerId ?? null}::bigint, ${d.supplierId ?? null}::bigint,
+          ${d.amount}::numeric, ${d.methodId}::uuid, ${reference}::text, ${note}::text, ${allocations}::jsonb
+        ) AS res
+      ), k AS (
+        INSERT INTO idempotency_keys (company_id, key, operation, result_reference)
+        SELECT ${companyId}::uuid, ${key}::text, 'payment_create', r.res->>'id' FROM r WHERE ${key}::text IS NOT NULL
+        RETURNING 1
+      )
+      SELECT res FROM r
+    `;
+    const res = rows[0]?.res as { id: string; number: string; allocated: number };
+    await logAudit(auth.user.id, "payment_record", "payment", res.id, `${d.direction} ${d.amount}`);
+    return NextResponse.json({ payment: { id: res.id, number: res.number, allocated: res.allocated } }, { status: 201 });
+  } catch (error) {
+    if (isUnique(error) && key) {
+      const previous = await replay().catch(() => null);
+      if (previous) return NextResponse.json({ payment: { id: previous.id, number: previous.number }, replayed: true });
+    }
+    if (isForeignKey(error)) return fail("Client ou fournisseur invalide.", 400);
+    return paymentFailure(error) ?? serverError("Impossible d’enregistrer le paiement.");
+  }
+}
diff -ruN -x node_modules -x tsconfig.tsbuildinfo orig/Gestion_de_Stock-main/app/api/payments/webhooks/mtn/route.ts Gestion_de_Stock-main/app/api/payments/webhooks/mtn/route.ts
--- orig/Gestion_de_Stock-main/app/api/payments/webhooks/mtn/route.ts	1970-01-01 00:00:00.000000000 +0000
+++ Gestion_de_Stock-main/app/api/payments/webhooks/mtn/route.ts	2026-10-28 01:45:08.156836718 +0000
@@ -0,0 +1,23 @@
+import { NextResponse } from "next/server";
+import { findSession, refreshSession } from "@/lib/payments/sessions";
+
+export const runtime = "nodejs";
+export const maxDuration = 30;
+
+async function handle(request: Request) {
+  const body = (await request.json().catch(() => null)) as { externalId?: unknown; referenceId?: unknown } | null;
+  const candidate = request.headers.get("x-reference-id") ?? (typeof body?.externalId === "string" ? body.externalId : typeof body?.referenceId === "string" ? body.referenceId : "");
+  if (!/^[0-9a-fA-F-]{36}$/.test(candidate)) return NextResponse.json({ ok: false }, { status: 400 });
+  try {
+    const session = await findSession({ provider: "mtn_money", externalId: candidate.toLowerCase() });
+    if (!session) return NextResponse.json({ ok: false }, { status: 404 });
+    await refreshSession(session); // le statut est relu chez MTN, jamais pris dans la notification
+    return NextResponse.json({ ok: true });
+  } catch {
+    return NextResponse.json({ ok: false }, { status: 500 });
+  }
+}
+
+/** MTN notifie par PUT ; POST accepté aussi. */
+export const PUT = handle;
+export const POST = handle;
diff -ruN -x node_modules -x tsconfig.tsbuildinfo orig/Gestion_de_Stock-main/app/api/payments/webhooks/orange/route.ts Gestion_de_Stock-main/app/api/payments/webhooks/orange/route.ts
--- orig/Gestion_de_Stock-main/app/api/payments/webhooks/orange/route.ts	1970-01-01 00:00:00.000000000 +0000
+++ Gestion_de_Stock-main/app/api/payments/webhooks/orange/route.ts	2026-10-28 01:45:08.156022322 +0000
@@ -0,0 +1,23 @@
+import { NextResponse } from "next/server";
+import { findSession, refreshSession } from "@/lib/payments/sessions";
+
+export const runtime = "nodejs";
+export const maxDuration = 30;
+
+/**
+ * Notification d'Orange Money. Aucune session n'est requise (appel de serveur à serveur), et la notification
+ * n'est jamais crue sur parole : le jeton doit correspondre à une demande connue, puis le statut est relu chez Orange.
+ */
+export async function POST(request: Request) {
+  const body = (await request.json().catch(() => null)) as { notif_token?: unknown } | null;
+  const token = typeof body?.notif_token === "string" ? body.notif_token : "";
+  if (token.length < 8) return NextResponse.json({ ok: false }, { status: 400 });
+  try {
+    const session = await findSession({ notifToken: token });
+    if (!session) return NextResponse.json({ ok: false }, { status: 404 });
+    await refreshSession(session);
+    return NextResponse.json({ ok: true });
+  } catch {
+    return NextResponse.json({ ok: false }, { status: 500 });
+  }
+}
