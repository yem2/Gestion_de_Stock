diff -ruN -x node_modules -x tsconfig.tsbuildinfo orig/Gestion_de_Stock-main/app/api/products/[id]/barcodes/[barcodeId]/route.ts Gestion_de_Stock-main/app/api/products/[id]/barcodes/[barcodeId]/route.ts
--- orig/Gestion_de_Stock-main/app/api/products/[id]/barcodes/[barcodeId]/route.ts	1970-01-01 00:00:00.000000000 +0000
+++ Gestion_de_Stock-main/app/api/products/[id]/barcodes/[barcodeId]/route.ts	2026-10-23 11:54:47.074972786 +0000
@@ -0,0 +1,28 @@
+import { NextResponse } from "next/server";
+import { getSql } from "@/lib/db";
+import { authorize, logAudit } from "@/lib/auth";
+import { rolesFor } from "@/lib/roles";
+import { fail, isUuid, parseId, serverError } from "@/lib/api";
+
+export const runtime = "nodejs";
+
+export async function DELETE(request: Request, context: { params: Promise<{ id: string; barcodeId: string }> }) {
+  const auth = await authorize(request, rolesFor("products.write"));
+  if ("error" in auth) return auth.error;
+  const params = await context.params;
+  const id = parseId(params.id);
+  if (!id || !isUuid(params.barcodeId)) return fail("Identifiant invalide.");
+  try {
+    const sql = getSql();
+    const rows = await sql`
+      DELETE FROM product_barcodes
+      WHERE id = ${params.barcodeId}::uuid AND product_id = ${id}::bigint AND company_id = ${auth.user.companyId}::uuid
+      RETURNING barcode
+    `;
+    if (rows.length === 0) return fail("Code-barres introuvable.", 404);
+    await logAudit(auth.user.id, "barcode_remove", "product", id, String(rows[0].barcode));
+    return NextResponse.json({ ok: true });
+  } catch {
+    return serverError("Impossible de supprimer le code-barres.");
+  }
+}
diff -ruN -x node_modules -x tsconfig.tsbuildinfo orig/Gestion_de_Stock-main/app/api/products/[id]/barcodes/route.ts Gestion_de_Stock-main/app/api/products/[id]/barcodes/route.ts
--- orig/Gestion_de_Stock-main/app/api/products/[id]/barcodes/route.ts	1970-01-01 00:00:00.000000000 +0000
+++ Gestion_de_Stock-main/app/api/products/[id]/barcodes/route.ts	2026-10-23 11:54:47.074152128 +0000
@@ -0,0 +1,51 @@
+import { NextResponse } from "next/server";
+import { getSql } from "@/lib/db";
+import { authorize, logAudit } from "@/lib/auth";
+import { rolesFor } from "@/lib/roles";
+import { fail, isForeignKey, isUnique, parseBody, parseId, serverError } from "@/lib/api";
+import { barcodeSchema } from "@/lib/validation";
+
+export const runtime = "nodejs";
+
+type Context = { params: Promise<{ id: string }> };
+
+export async function GET(request: Request, context: Context) {
+  const auth = await authorize(request);
+  if ("error" in auth) return auth.error;
+  const id = parseId((await context.params).id);
+  if (!id) return fail("Identifiant invalide.");
+  try {
+    const sql = getSql();
+    const barcodes = await sql`
+      SELECT id, barcode FROM product_barcodes
+      WHERE company_id = ${auth.user.companyId}::uuid AND product_id = ${id}::bigint
+      ORDER BY created_at ASC
+    `;
+    return NextResponse.json({ barcodes });
+  } catch {
+    return serverError();
+  }
+}
+
+export async function POST(request: Request, context: Context) {
+  const auth = await authorize(request, rolesFor("products.write"));
+  if ("error" in auth) return auth.error;
+  const id = parseId((await context.params).id);
+  if (!id) return fail("Identifiant invalide.");
+  const body = await parseBody(request, barcodeSchema);
+  if ("error" in body) return body.error;
+  try {
+    const sql = getSql();
+    const rows = await sql`
+      INSERT INTO product_barcodes (company_id, product_id, barcode)
+      VALUES (${auth.user.companyId}::uuid, ${id}::bigint, ${body.data.barcode})
+      RETURNING id, barcode
+    `;
+    await logAudit(auth.user.id, "barcode_add", "product", id, body.data.barcode);
+    return NextResponse.json({ barcode: rows[0] }, { status: 201 });
+  } catch (error) {
+    if (isUnique(error)) return fail("Ce code-barres est déjà utilisé par un produit.", 409);
+    if (isForeignKey(error)) return fail("Produit introuvable.", 404);
+    return serverError("Impossible d’ajouter le code-barres.");
+  }
+}
